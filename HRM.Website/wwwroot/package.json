        "build:app:dev": "node --openssl-legacy-provider node_modules/webpack/bin/webpack.js --config webpack.config.js --watch",
        "build:app:pro": "node --max_old_space_size=4096 --openssl-legacy-provider node_modules/webpack/bin/webpack.js --config webpack.config.js --env=production",
        "build:all:dev": "node --openssl-legacy-provider node_modules/webpack/bin/webpack.js --config webpack.config.vendor.js && node --openssl-legacy-provider node_modules/webpack/bin/webpack.js --config webpack.config.js",
        "build:all:pro": "node --openssl-legacy-provider node_modules/webpack/bin/webpack.js --config webpack.config.vendor.js --env=production && node --openssl-legacy-provider node_modules/webpack/bin/webpack.js --config webpack.config.js --env=production",
        "start": "node --openssl-legacy-provider node_modules/.bin/webpack-dev-server --config webpack.config.dev.js --hot --inline --progress",
