@{
    ViewBag.Title = Labels.Dashboard;
}
@section css{
    <link href="~/dist/styles/home.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/dist/js/home.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@Labels.MySpace</h2>
<table class="table table-custom">
    <thead>
        <tr>
            <th class="align-left">@Labels.Request</th>
            <th>@DateTime.Now.ToString("MMM yyyy")</th>
            <th>@Labels.Pending</th>
            <th>@Labels.CreateRequest</th>
        </tr>
    </thead>
    <tbody>
    </tbody>
</table>