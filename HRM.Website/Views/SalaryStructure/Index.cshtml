@using HRM.Resources
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model bool
@{
    ViewBag.Title = Labels.SalaryStructure;
}
@section css{
    <link href="~/dist/styles/salary-structure.css" rel="stylesheet" />
}
@section js{
    <script type="text/javascript">
        window.hasPermission = "@Model";
    </script>
    <script src="~/dist/js/salary-structure.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div id="salary-structure"></div>