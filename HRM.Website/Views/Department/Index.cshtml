@using HRM.Resources
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model bool
@{
	ViewBag.Title = Labels.DepartmentManagement;
}
@section css{
	<link href="~/dist/styles/department.index.css" rel="stylesheet" />
}
@section js{
	<script type="text/javascript">
        window.hasPermission = "@Model";
    </script>
	<script src="~/dist/js/department.home.js"></script>
}
@section Breadcrumb {
	<a class="step">@Labels.GroupSpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div id="department"></div>