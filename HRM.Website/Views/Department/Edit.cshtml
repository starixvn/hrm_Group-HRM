@using HRM.Resources
@model int

@{
    ViewBag.Title = Labels.EditDepartment;
}
@section css{
    <link href="~/dist/styles/department.create.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script>window.departmentId = @Model;</script>
    <script src="~/dist/js/department.edit.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.GroupSpace</a>
    <a class="step" href="@Url.Action("index", "department")">@Labels.DepartmentManagement</a>
    <span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@Labels.Edit</h2>
<div id="department-edit"></div>