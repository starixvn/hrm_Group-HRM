@using HRM.Core.Enums
@using HRM.Resources
@{
    ViewBag.Title = "Edit Team Supervisor";
    var teamId = (int)ViewBag.TeamId;
    var roleId = (short)ViewBag.RoleId;
    var breadcrumb = string.Empty;
}
@section css{
    <link href="~/dist/styles/team.edit.supervisor.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/groupteam.supervisor.index.js" asp-append-version="true"></script>
}
@section Breadcrumb
{
    <a class="step">@Labels.GroupSpace</a>
    <a href="@Url.Action("index", "GroupTeam")" class="step">@Labels.TeamManagement</a>
    <a href="@Url.Action("TeamSupervisor", "GroupTeam", new { id = teamId })" class="step">@Labels.TeamSupervisor</a>
    <a class="step">
        @{ breadcrumb = roleId switch
            {
                (short)RoleSystem.Verifier => Labels.Verifier,
                (short)RoleSystem.Approver => Labels.Approver,
                _ => breadcrumb
            }; }
        @breadcrumb
    </a>
}

@Html.Hidden("TeamId", teamId)
@Html.Hidden("RoleId", roleId)
<div id="supervisor-wrapper"></div>