@using HRM.Core.Enums
@using HRM.Resources
@model List<HRM.Models.Supervisor.TeamSupervisorModel>
@{
    ViewBag.Title = Labels.TeamSupervisor;
    var teamId = ViewBag.TeamId;
}
@section Breadcrumb {
    <a class="step">@Labels.GroupSpace</a>
    <a href="@Url.Action("index", "GroupTeam")" class="step">@Labels.TeamManagement</a>
    <a class="step">@ViewBag.Title</a>
}

@section css {
    <link href="~/dist/styles/team.supervisor.index.css" rel="stylesheet" asp-append-version="true" />
}

<h2 class="page-title">@Labels.Team: @ViewBag.TeamName</h2>
<table class="table table-custom" style="width: auto; min-width: 800px;">
    <thead>
        <tr>
            <th>@Labels.Roles</th>
            <th>@Labels.NickName</th>
            <th>@Labels.Edit</th>
        </tr>
    </thead>
    @if (Model != null)
    {
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td class="align-left">
                        @item.ActionName
                    </td>
                    <td class="align-left">
                        @item.Supervisors
                    </td>
                    <td>
                        @switch (item.ActionType)
                        {
                            case (short)RoleSystem.Verifier:
                            case (short)RoleSystem.Approver:
                                    <a href="@Url.Action("ManageSupervisor", "GroupTeam", new { id = teamId, roleId = item.ActionType })">
                                        <i class="fa fa-pencil fa-lg icon-edit"></i>
                                    </a>
                                break;
                            case (short)RoleSystem.ShiftManager:
                                <a href="@Url.Action("ShiftManager", "GroupTeam", new { id = teamId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                break;
                            case (short)RoleSystem.DisciplineManager:
                                <a href="@Url.Action("DisciplineManager", "GroupTeam", new { id = teamId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                break;
                            case (short)RoleSystem.LeaderTakeover:
                                <a href="@Url.Action("LeaderTakeoverManager", "GroupTeam", new { id = teamId })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                break;
                            case (short)RoleSystem.OnBehalfRequest:
                                <a href="@Url.Action("ManageSupervisor", "GroupTeam", new { id = teamId, roleId = item.ActionType })">
                                    <i class="fa fa-pencil fa-lg icon-edit"></i>
                                </a>
                                break;
                            default:
                                // do nothing
                                break;
                        }
                    </td>
            </tr>
            }
        </tbody>
    }
</table>