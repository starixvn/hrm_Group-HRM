@using HRM.Core
@model HRM.ViewModels.Employee.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Check in/out</title>
    <link href="~/dist/styles/time.checkinout.css" rel="stylesheet" />
</head>
<body>
    <div id="app"></div>
    <input type="hidden" id="currentDateTime" value="@DateTimeOffset.Now.DateTime.ToClientTimeZone().ToString("dd MMM, yyyy HH:mm:ss")" />
    @Html.Hidden("RootURL", Url.Content("~/"))
    <script src="~/dist/js/time.checkinout.js" defer></script>
</body>
</html>