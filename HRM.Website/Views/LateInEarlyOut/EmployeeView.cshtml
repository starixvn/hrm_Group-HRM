@using HRM.Core
@using HRM.Core.Enums
@using HRM.Models.Request
@using HRM.Resources
@using HRM.Website.Helper
@model IList<LateInEarlyOutRequest>
@{
    ViewBag.Title = Labels.MyLateInEarlyOutRequest;
}
@section css{
    <link href="~/dist/styles/changeshift.myrequest.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/lateinearlyout.myrequest.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a><a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm("employeeview", "lateinearlyout", FormMethod.Get, new { @class = "filter" }))
{
    <div class="form-horizontal clearfix">
        <div class="form-group year">
            <div class="label-form">
                <label class="control-label">@Labels.Year</label>
            </div>
            <div class="select-form">
                @{
                    var yearPicker = Extensions.YearPicker(2010, (int)ViewBag.Year);
                    <select class="yearpicker form-control" name="year" id="year">
                        @foreach (var item in yearPicker)
                        {
                            <!option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Value</!option>
                        }
                    </select>
                }
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="submit" id="btnSearch" class="btn btn-primary">@Labels.Search</button>
            <a class="btn btn-request" href="@Url.Action("create", "lateinearlyout")">
                <span class="fa fa-plus"></span> @Labels.NewRequest
            </a>
        </div>
    </div>
}
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th>@Labels.Request</th>
            <th>@Labels.Time</th>
            <th>@Labels.ActualTime</th>
            <th>@Labels.RequestDate</th>
            <th>@Labels.Shift</th>
            <th>@Labels.Reason</th>
            <th>@Labels.Remark</th>
            <th>@Labels.FileAttach</th>
            <th>@Labels.Verifier</th>
            <th>@Labels.Approver</th>
            <th>@Labels.CreatedDate</th>
            <th>@Labels.Status</th>
            <th>@Labels.History</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        var index = 1;
        <tbody>
            @foreach (var request in Model)
            {
                var totalMins = request.RequestTypeId == (byte)RequestType.LateIn ? request.LateInMins : request.EarlyOutMins;
            <tr>
                <td>@(index++)</td>
                <td>@request.RequestTypeName</td>
                <td>
                    @RazorHelpers.LateInEarlyOutTimeFormat(totalMins, request.RequestTypeId)
                </td>
                <td>
                    @if (request.ActualLateInEarlyOut == 0)
                    {
                        <span>N/A</span>
                    }
                    else
                    {
                        @RazorHelpers.LateInEarlyOutTimeFormat(request.ActualLateInEarlyOut, request.RequestTypeId)
                    }
                </td>
                <td>@request.OnDate.ToDateMonthYearFormatedDate()</td>
                <td>@request.ShiftName</td>
                <td>@request.ReasonName</td>
                <td>
                    @if (!string.IsNullOrWhiteSpace(request.Remark))
                    {
                        <span class="fa fa-comment tooltip-tipsy" title="@request.Remark"></span>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </td>
                <td>
                    @foreach (var file in request.AttachFiles)
                    {
                        <a href="@file.FilePath" class="attach-file">
                            <span class="file-name">@file.FileNameWithoutExtension</span><span class="file-extension">@file.Extension</span>
                        </a>
                    }
                </td>
                <td>
                    @GetNickname(request.Verifier)
                </td>
                <td>
                    @GetNickname(request.Approver)
                </td>
                <td>@request.CreatedDate.ToShortFormatedDate()</td>
                <td>@{RenderStatus(request);}</td>
                <td>
                    <a class="viewhistory" href="javascript:;" requestid="@request.RequestId">@Labels.View</a>
                </td>
            </tr>
            }
        </tbody>
    }
    else
    {
        @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 14))
    }
</table>
@{
    void RenderStatus(LateInEarlyOutRequest request)
    {
        switch (request.Status.Id)
        {
            case (byte)CurrentRequestStatus.Pending:
                RenderPendingStatus(request);
                break;
            case (byte)CurrentRequestStatus.Verified:
            case (byte)CurrentRequestStatus.NotVerified:
                RenderStatusWithTooltip(request, GetNickname(request.Verifier), request.VerifiedDate);
                break;
            case (byte)CurrentRequestStatus.Approved:
            case (byte)CurrentRequestStatus.Rejected:
                RenderStatusWithTooltip(request, GetNickname(request.ApprovedBy), request.ApprovedDate);
                break;
            case (byte)CurrentRequestStatus.Processed:
            case (byte)CurrentRequestStatus.Void:
                RenderStatusWithTooltip(request, GetNickname(request.HR), request.ProcessedDate);
                break;
            default:
                <a href="javascript:;">@request.Status.ToString()</a>
                break;
        }
    }

    void RenderPendingStatus(LateInEarlyOutRequest request)
    {
        <a requestid="@request.RequestId" class="menu-actions" href="javascript:;">
            @request.Status.ToString()
            <span class="caret"></span>
        </a>
    }

    void RenderStatusWithTooltip(LateInEarlyOutRequest request, string actorName, DateTime actionDate)
    {
        <a requestid="@request.RequestId" href="javascript:;" class="tooltip-tipsy"
           title="@request.Status.Name by @actorName (@actionDate.ToShortFormatedDate())">
            @request.Status.ToString()
        </a>
    }

    string GetNickname(Requester requester) => requester != null ? requester.Nickname : string.Empty;
}
<div id="dialoghistorycontent"></div>