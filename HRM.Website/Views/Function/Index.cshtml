@using GO.UserControl.Client.Core.Enumerables
@{
	ViewBag.Title = Labels.FunctionManagement;
	var read = (byte)Policy.Read;
	var host = (byte)Policy.Host;
}
@section css{
	<link href="~/dist/styles/function.index.css" rel="stylesheet" />
}
@section js{
	<script type="text/javascript">
        window.read = "@read",
            window.host = "@host";
    </script>
	<script src="~/dist/js/function.index.js"></script>
}
@section Breadcrumb {
	<a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div id="function"></div>