@using HRM.Models
@model CreateShiftModel
@{
    ViewBag.Title = @Labels.Shift;
}
@section css{
    <link href="~/dist/styles/shift.edit.css" rel="stylesheet" />
}
@section js{
    <script src="~/dist/js/shift.edit.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("index", "shift")">@Labels.ShiftManagement</a>
    <span class="step">@Labels.Create</span>
}
<h2 class="page-title">@Labels.Create</h2>
<div class="card">
    <form class="form-horizontal clearfix" method="post">
        @Html.ValidationSummary()

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Name, new { @class = "control-label" })*
            </div>
            <div class="input-form input-form-custom">
                @Html.TextBoxFor(model => model.Name, new { maxlength = "20", @class = "form-control shift-name" })
            </div>
        </div>

        <div class="form-group input-time">
            <div class="label-form">
                @Html.LabelFor(model => model.HourTimeIn, @Labels.TimeIn, new { @class = "control-label" })*
            </div>
            <div class="input-form input-form-custom">
                <input type="number" name="HourTimeIn" id="HourTimeIn" class="form-control"
                       min="0" max="23" step="1" maxlength="2" value="@Model.HourTimeIn" />
                :
                <input type="number" name="MinuteTimeIn" id="MinuteTimeIn" class="form-control"
                       min="0" max="59" step="1" maxlength="2" value="@Model.MinuteTimeIn" />
                <div class="checkbox-group">
                    @Html.CheckBoxCustomFor(model => model.IsInAfterDay)
                    @Html.LabelFor(model => model.IsInAfterDay, new { @class = "checkbox-label" })
                </div>
            </div>
        </div>

        <div class="form-group input-time">
            <div class="label-form">
                @Html.LabelFor(model => model.HourTimeOut, @Labels.TimeOut, new { @class = "control-label" })*
            </div>
            <div class="input-form">
                <input type="number" name="HourTimeOut" id="HourTimeOut" class="form-control"
                       min="0" max="23" step="1" maxlength="2" value="@Model.HourTimeOut" />
                :
                <input type="number" name="MinuteTimeOut" id="MinuteTimeOut" class="form-control"
                       min="0" max="59" step="1" maxlength="2" value="@Model.MinuteTimeOut" />
                <div class="checkbox-group">
                    @Html.CheckBoxCustomFor(model => model.IsOutAfterDay)
                    @Html.LabelFor(model => model.IsOutAfterDay, new { @class = "checkbox-label" })
                </div>
            </div>
        </div>

        <div class="form-group">
            <div class="label-form">
            </div>
            <div class="input-form">
                <input type="submit" class="btn btn-primary" value="@Labels.Save" />
                <a href="@Url.Action("index", "shift")" class="btn btn-default">@Labels.Back</a>
            </div>
        </div>
    </form>
</div>
