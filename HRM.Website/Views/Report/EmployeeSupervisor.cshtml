@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.Report.EmployeeAndTeamSupervisorViewModel

@{
    ViewBag.Title = Labels.EmployeePermissionSummary;
}
@section css{
    <link href="~/dist/styles/report.employee.supervisor.css" rel="stylesheet" />
}
@section js{
    <script src="~/dist/js/report.employee.supervisor.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "team")">@Labels.Team</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>

<form class="filter">
    <div class="form-horizontal clearfix">
        @Html.HiddenFor(model => model.TeamIds)
        @Html.HiddenFor(model => model.IsLocal)
        @Html.HiddenFor(model => model.EmployeeId)
        <div class="form-group form-group--l">
            <div class="label-form">
                @Html.Label(null, Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", "", new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Team</label>
            </div>
            <div class="input-form" id="Team"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(null, Labels.Category, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.Raw(RazorHelpers.CategoryDropDownList("category", "form-control"))
            </div>
        </div>
        <div class="form-group form-group--m">
            <button id="btnSubmit" type="button" class="btn btn-primary">@Labels.Submit</button>
            <button id="btnExcel" type="button" class="btn btn-excel">@Labels.Excel</button>
        </div>
    </div>
</form>
<div id="EmployeeSupervisorDetails"></div>