@using HRM.Core
@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.Report.Overtime.YearlyOvertimeViewModel
@{
    ViewBag.Title = Labels.YearlyOvertimeReport;
    const double epsilon = 0.0001;
}
@section css{
    <link href="~/dist/styles/report.yearlyovertime.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/report.yearlyovertime.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<form class="filter">
    @Html.HiddenFor(model => model.TeamIds)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Year, Labels.Year, new { @class = "control-label" })
            </div>
            <div class="select-form">
                <div class="select-form">
                    @{
                        var yearPicker = Extensions.YearPicker(2010, Model.Year);
                        <select class="yearpicker form-control" name="year" id="year">
                            @foreach (var item in yearPicker)
                            {
                                <!option value="@item.Value" @(item.Selected ? "selected" : "")>@item.Value</!option>
                            }
                        </select>
                    }
                </div>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Calendar, Labels.Calendar, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @{
                    var calendarType = new List<SelectListItem>
                            {
                        new() {Text = Labels.Fiscal, Value = "1"},
                        new() {Text = Labels.Normal, Value = "0"}
                            };
                }
                @Html.DropDownListFor(model => model.Calendar, calendarType, new { @class = "form-control" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Category, Labels.Category, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.Raw(RazorHelpers.CategoryDropDownList("IsLocal",
                    classHTML: "form-control",
                    selectedId: Model.IsLocal.HasValue ? Model.IsLocal.Value.ToString() : string.Empty))
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Team</label>
            </div>
            <div class="select-form" id="Team"></div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Keyword, Labels.Keyword, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Employee,
                    new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control", maxlength = 200, autocomplete = "off" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.UserStatus, Labels.UserStatus, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.Raw(RazorHelpers.UserStatusDropDownList("EmployeeStatusId", classHTML: "form-control", selectedId: Model.EmployeeStatusId))
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Department</div>
                    <div class="fa fa-sort" data-property="Department"></div>
                </div>
            </th>
            <th rowspan="2">@Labels.Team</th>
            <th rowspan="2">@Labels.FullName</th>
            <th rowspan="2">@Labels.NickName</th>
            <th colspan="12">
                Overtime Summary in @Model.Year
            </th>
            <th rowspan="2">@Labels.Total</th>
        </tr>
        <tr>
            <th>@Labels.Jan</th>
            <th>@Labels.Feb</th>
            <th>@Labels.Mar</th>
            <th>@Labels.Apr</th>
            <th>@Labels.May</th>
            <th>@Labels.Jun</th>
            <th>@Labels.Jul</th>
            <th>@Labels.Aug</th>
            <th>@Labels.Sep</th>
            <th>@Labels.Oct</th>
            <th>@Labels.Nov</th>
            <th>@Labels.Dec</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Overtimes.Any())
        {
            var rowIndex = 0;
            foreach (var overtime in Model.Overtimes)
            {
                rowIndex++;
                <tr>
                    <td>@rowIndex</td>
                    <td class="align-left">@overtime.DepartmentName</td>
                    <td class="align-left">@overtime.TeamName</td>
                    <td class="align-left">@overtime.FullName</td>
                    <td class="align-left">@overtime.Nickname</td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Jan) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 1, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Jan
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Feb) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 2, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Feb
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Mar) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 3, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Mar
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Apr) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 4, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Apr
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.May) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 5, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.May
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Jun) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 6, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Jun
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Jul) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 7, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Jul
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Aug) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 8, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Aug
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Sep) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 9, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Sep
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Oct) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 10, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Oct
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Nov) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 11, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Nov
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Dec) > epsilon)
                        {
                            <a href="@Url.Action("MonthlyOvertimeDetails", "OvertimeReport",
                                            new { employeeId = overtime.EmpId, month = 12, year = Model.Year, calendar = Model.Calendar })">
                                @overtime.Dec
                            </a>
                        }
                    </td>
                    <td class="align-right">
                        @if (Math.Abs(overtime.Total) > epsilon)
                        {
                            @overtime.Total
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(18))
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            <td colspan="5" class="align-right">@Labels.TotalHours:</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Jan)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Feb)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Mar)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Apr)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.May)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Jun)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Jul)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Aug)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Sep)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Oct)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Nov)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Dec)</td>
            <td class="align-right">@Model.Overtimes.Sum(x => x.Total)</td>
        </tr>
    </tfoot>
</table>