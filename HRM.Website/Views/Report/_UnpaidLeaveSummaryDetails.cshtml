@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Html
@using System.Web
@model HRM.ViewModels.AnnualLeave.LeaveSummaryViewModel

<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th rowspan="2">@Labels.Department</th>
            <th rowspan="2">@Labels.Team</th>
            <th rowspan="2">@Labels.FullName</th>
            <th rowspan="2">@Labels.NickName</th>
            <th colspan="@(Model.Period is "1" or "2" ? "6" : "12")">
                Take @ViewBag.HeaderTitle
            </th>
            <th rowspan="2">
                Total of @ViewBag.HeaderTitle
            </th>
        </tr>
        <tr>
            @RenderMonthHeaders(Model.Period)
        </tr>
    </thead>
    @if (Model.LeaveSumaries != null)
    {
        <tbody>
            @{var index = 1;}
            @foreach (var item in Model.LeaveSumaries)
            {
                double balance;
            <tr>
                <td>@(index++)</td>
                <td class="align-left">@item.Department</td>
                <td class="align-left">@item.Team</td>
                <td class="align-left">@item.FullName</td>
                <td class="align-left">@item.Nickname</td>
                @switch (Model.Period)
                {
                    case "1":
                    {
                        balance = item.Jan + item.Feb + item.Mar + item.Apr + item.May + item.Jun;
                        <td>
                            @{RenderLeaveDays(item.Jan);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Feb);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Mar);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Apr);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.May);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Jun);}
                        </td>
                        break;
                    }
                    case "2":
                    {
                        balance = item.Jul + item.Aug + item.Sep + item.Oct + item.Nov + item.Dec;
                        <td>
                            @{RenderLeaveDays(item.Jul);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Aug);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Sep);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Oct);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Nov);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Dec);}
                        </td>
                        break;
                    }
                    default:
                    {
                        balance = item.LeaveBalance;
                        <td>
                            @{RenderLeaveDays(item.Jan);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Feb);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Mar);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Apr);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.May);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Jun);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Jul);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Aug);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Sep);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Oct);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Nov);}
                        </td>
                        <td>
                            @{RenderLeaveDays(item.Dec);}
                        </td>
                        break;
                    }
                }

                <td style="width: 250px">
                    @balance.ToString("0.0")
                </td>
            </tr>
            }
        </tbody>
    }
    else
    {
        @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 18))
    }
</table>
@{
    void RenderLeaveDays(float days)
    {
        if (days > 0)
        {
            @days.ToString("0.0")
        }
    }

    IHtmlContent RenderMonthHeaders(string period)
    {
        switch (period)
        {
            case "1":
                return RenderFirstHalfMonths();
            case "2":
                return RenderSecondHalfMonths();
            default:
                return RenderAllMonths();
        }
    }

    IHtmlContent RenderFirstHalfMonths()
    {
        return new HtmlString($@"
            <th>{Labels.Jan}</th>
            <th>{Labels.Feb}</th>
            <th>{Labels.Mar}</th>
            <th>{Labels.Apr}</th>
            <th>{Labels.May}</th>
            <th>{Labels.Jun}</th>
        ");
    }

    IHtmlContent RenderSecondHalfMonths()
    {
        return new HtmlString($@"
            <th>{Labels.Jul}</th>
            <th>{Labels.Aug}</th>
            <th>{Labels.Sep}</th>
            <th>{Labels.Oct}</th>
            <th>{Labels.Nov}</th>
            <th>{Labels.Dec}</th>
        ");
    }

    IHtmlContent RenderAllMonths()
    {
        return new HtmlString(RenderFirstHalfMonths().ToString() + RenderSecondHalfMonths().ToString());
    }
}