@using HRM.Core
@using HRM.Core.Constants
@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.Report.WorkingHours.MonthlyFilterViewModel
@{
    ViewBag.Title = Labels.AttendanceMonthlyDetail;

    var today = DateTimeOffset.Now.DateTime.ToClientTimeZone().Date;
    var minDate = Constants.MinDate.ToString("yyyy/MM/dd");
    var maxDate = new DateTimeOffset(today.Year, today.Month, DateTime.DaysInMonth(today.Year, today.Month), 0, 0, 0, TimeSpan.Zero).ToString("yyyy/MM/dd");
}
@section css{
    <link href="~/dist/styles/report.monthlyworkinghours.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/report.monthlyworkinghours.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>

<form class="filter">
    @Html.HiddenFor(model => model.TeamIds)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.FromDate</label>
            </div>
            <div class="calendar-form">
                @Html.TextBox("FromDate", Model.FromDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = minDate,
                        maxdate = maxDate,
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.ToDate</label>
            </div>
            <div class="calendar-form">
                @Html.TextBox("ToDate", Model.ToDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = minDate,
                        maxdate = maxDate,
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Category</label>
            </div>
            <div class="select-form">
                @Html.Raw(RazorHelpers.CategoryDropDownList("IsLocal", classHTML: "form-control", selectedId: string.Empty))
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Team</label>
            </div>
            <div class="select-form" id="Team"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Keyword</label>
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Employee,
                    new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control", maxlength = 200, autocomplete = "off" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.UserStatus</label>
            </div>
            <div class="input-form">
                @Html.Raw(RazorHelpers.UserStatusDropDownList("EmployeeStatusId", classHTML: "form-control", selectedId: Model.EmployeeStatusId))
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<div id="MonthlyWorkingHoursDetails"></div>