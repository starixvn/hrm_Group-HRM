@using HRM.Core.Enums
@using HRM.Models.Report.MonthlyWorkingHours
@using HRM.Resources
@using HRM.Website.Helper
@model IEnumerable<MonthlyWorking>
@{
    var fromDate = (DateTime)ViewBag.FromDate;
    var toDate = (DateTime)ViewBag.ToDate;
}
<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.BusinessUnit</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Department</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th class="cell-section">@Labels.Team</th>
            <th>@Labels.Code</th>
            <th class="cell-fullname">@Labels.FullName</th>
            <th>@Labels.NickName</th>
            <th>@Labels.ActualWorkingDays</th>
            @for (var day = fromDate.Date; day.Date <= toDate.Date; day = day.AddDays(1))
            {
                <th class="@(day.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday ? "weekend" : string.Empty)">
                    @day.ToString("dd MMM, yyyy (ddd)")
                </th>
            }
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        var index = 0;
        <tbody>
            @foreach (var monthlyWorking in Model)
            {
                var rowClass = monthlyWorking.IsDeleted ? "deleted-user-row" : monthlyWorking.Enabled ? "enable-user-row" : "disabled-user-row";
                index++;
                <tr class="@rowClass">
                    <td>@index</td>
                    <td class="align-left">@monthlyWorking.UnitCode</td>
                    <td class="align-left">@monthlyWorking.DepartmentName</td>
                    <td class="align-left">@monthlyWorking.TeamName</td>
                    <td class="align-left">@monthlyWorking.Code</td>
                    <td class="align-left">@monthlyWorking.FullName</td>
                    <td class="align-left">@monthlyWorking.Nickname</td>
                    <td>@monthlyWorking.ActualWorkingDays.ToString("0.0")</td>
                    @foreach (var dailyWorking in monthlyWorking.DailyWorkings)
                    {
                        var className = string.Empty;
                        var value = string.Empty;
                        if (dailyWorking.IsLeaveDay)
                        {
                            if (dailyWorking.IsHoliday)
                            {
                                value = "PH";
                            }
                            else if (dailyWorking.IsOffDay)
                            {
                                value = "OFF";
                            }
                            else
                            {
                                if (dailyWorking.RequestStatusId == (byte)CurrentRequestStatus.Pending)
                                {
                                    className = "pending";
                                }

                                if (dailyWorking.LeaveTypeId is (byte)LeaveTypes.UnpaidLeave or (byte)LeaveTypes.UnpaidLeaveInsurance or (byte)LeaveTypes.MaternityLeave or (byte)LeaveTypes.PaternityLeave
                                    || dailyWorking.LeaveTypeId2 is (byte)LeaveTypes.UnpaidLeave or (byte)LeaveTypes.UnpaidLeaveInsurance or (byte)LeaveTypes.MaternityLeave or (byte)LeaveTypes.PaternityLeave)
                                {
                                    className += " unpaidleave";
                                }
                                if (dailyWorking.IsLeaveHalfDay)
                                {
                                    if (dailyWorking.LeaveTypeId != (byte)LeaveTypes.KeepInViewByHour)
                                    {
                                        value = $"{dailyWorking.LeaveTypeCode}½";
                                    }
                                }
                                else
                                {
                                    value = dailyWorking.LeaveTypeCode;
                                    if (dailyWorking.LeaveTypeId2.HasValue && dailyWorking.LeaveTypeId != dailyWorking.LeaveTypeId2.Value)
                                    {
                                        value = $"{dailyWorking.LeaveTypeCode}½/{dailyWorking.LeaveTypeCode2}½";
                                    }
                                }
                            }
                        }
                        else if (dailyWorking.TotalWorkingHours > 0)
                        {
                            value = dailyWorking.TotalWorkingHoursToDisplay;
                        }
                        else if (dailyWorking.IsMissingCheckIn)
                        {
                            value = "Check In";
                        }
                        else if (dailyWorking.IsMissingCheckOut)
                        {
                            value = "Check Out";
                        }
                        else if (dailyWorking.IsAbsent)
                        {
                            value = "Absent";
                        }
                        else if (dailyWorking.IsHoliday)
                        {
                            value = "PH";
                        }
                        else if (dailyWorking.IsOffDay)
                        {
                            value = "OFF";
                        }
                        <td class="@className">@value</td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 41))
    }
</table>