@using HRM.Core
@using HRM.Core.Enums
@using HRM.Models.Request
@using HRM.Models.Shifts
@using HRM.Resources
@using HRM.Services.Implement.Request
@using HRM.Website.Helper
@model IEnumerable<HRM.ViewModels.Report.EmployeeAttendanceModel>

<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Date
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
	            <div class="cell-control-wrapper">
		            @Labels.BusinessUnit
		            <div class="fa fa-sort cell-right-div"></div>
	            </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Department
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Team
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.NickName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Shift
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.CheckIn
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.CheckOut
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.TotalHours
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.LateIn
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.EarlyOut
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th>@Labels.Request</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Overtime
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th>@Labels.Note</th>
            <th></th>
        </tr>
    </thead>
    <tbody id="attendanceDetails">
        @if (Model != null && Model.Any())
        {
            var index = 0;
            foreach (var item in Model)
            {
                index++;
                var trClass = item.LateIn > 0 || item.EarlyOut > 30 ? "highlight" : string.Empty;

                <tr class="@trClass">
                    <td>@index</td> 
                    @if (item.IsWeekend)
                    {
                        <td class="weekend">@item.AttendanceDate.ToString("ddd, dd MMM, yyyy")</td>
                    }
                    else
                    {
                        <td>@item.AttendanceDate.ToString("ddd, dd MMM, yyyy")</td>
                    }
                    <td>@item.UnitCode</td>
                    <td>@item.DepartmentCode</td>
                    <td>
                        <span class="tooltip-tippy" data-tippy-content="@item.Team">@item.TeamCode</span>
                    </td>
                    <td>
                        <span class="tooltip-tippy" data-tippy-content="@item.FullName">@item.NickName</span>
                    </td>

                    @if (item.IsOffdayOT)
                    {
                        var title = !string.IsNullOrEmpty(item.ShiftCode) && !string.IsNullOrEmpty(item.ExpectedInTime) ? item.ExpectedInTime + "-" + item.ExpectedOutTime : string.Empty;
                        var className = $"mytimesheet-workinginoffday {(item.IsPublicHoliday && !string.IsNullOrEmpty(item.ShiftCode) ? "holiday" : "")}";
                        <td class="@className">
                            <span class="tooltip-tippy" data-tippy-content="@title">@item.ShiftCode</span>
                        </td>
                    }
                    else
                    {
                        var title = !string.IsNullOrEmpty(item.ShiftCode) && !string.IsNullOrEmpty(item.ExpectedInTime) ? item.ExpectedInTime + "-" + item.ExpectedOutTime : string.Empty;
                        var className = $" {(item.IsPublicHoliday & !string.IsNullOrEmpty(item.ShiftCode) ? "holiday" : "")}";
                        <td class="@className">
                            @if (!string.IsNullOrEmpty(title))
                            {
                                <span class="tooltip-tippy" data-tippy-content="@title">@item.ShiftCode</span>
                            }
                            else
                            {
                                <span>@item.ShiftCode</span>
                            }
                        </td>
                    }
                    <td>
                        @if (item.InFixed.HasValue)
                        {
                            <span class="tooltip-tippy" data-tippy-content="@item.InFixed.Value.ToClientTimeZone().ToString("ddd, dd MMM, yyyy HH:mm:ss")">
                                @item.InFixed.Value.ToClientTimeZone().ToString("HH:mm")
                            </span>
                        }
                    </td>
                    <td>
                        @if (item.OutFixed.HasValue)
                        {
                            <span class="tooltip-tippy"
                                  data-tippy-content="@item.OutFixed.Value.ToClientTimeZone().ToString("ddd, dd MMM, yyyy HH:mm:ss")">
                                @item.OutFixed.Value.ToClientTimeZone().ToString("HH:mm")
                            </span>
                        }
                    </td>
                    <td>
                        @if (item.TotalWorkHours > 0)
                        {
                            @Utilities.TotalHoursToTime((float)item.TotalWorkHours)
                        }
                    </td>
                    <td>
                        @if (item.LateIn > 0)
                        {
                            @Utilities.MinuteToTime(item.LateIn)
                        }
                    </td>
                    <td>
                        @if (item.EarlyOut > 0)
                        {
                            @Utilities.MinuteToTime(item.EarlyOut)
                        }
                    </td>
                    <td>
                        @if (item.RequestList != null && item.RequestList.Any())
                        {
                            foreach (var request in item.RequestList)
                            {
                                var statusClass = request.CurrentStatus is (byte)CurrentRequestStatus.Pending or (byte)CurrentRequestStatus.Verified
                                    ? " pending-request" : string.Empty;
                                var className = "tooltip-request req" + statusClass;
                                var requestEntity = new RequestEntity
                                {
                                    RequestType = request.RequestType,
                                    TotalDays = request.TotalDays ?? 0,
                                    TotalMins = request.TotalMins ?? 0,
                                    FromDate = request.FromDate.Value,
                                    ToDate = request.ToDate.Value,
                                    FromTime = request.FromTime ?? request.FromDate.Value,
                                    ToTime = request.ToTime ?? request.ToDate.Value,
                                    RequestedDate = request.RequestDate,
                                    CreatedDate = request.CreatedDate,
                                    FromShift = new Shift { Name = request.FromShift },
                                    ToShift = new Shift { Name = request.ToShift },
                                    LeaveType = request.LeaveType,
                                    ActualLateInEarlyOut = request.RequestType.Id == (byte)RequestType.LateIn ? item.LateIn : item.EarlyOut,
                                    KeepInViewType = request.KeepInViewTypeId ?? 0
                                };
                                var requestDetail = RequestService.ToRequestMessage(requestEntity);
                                <div class="@className"
                                     data-requestdetail="@Html.Encode(requestDetail)"
                                     data-leavetype="@(request.LeaveType != null ? request.LeaveType.Name : string.Empty)"
                                     data-createddate="@(request.CreatedDate.ToShortFormatedDate())"
                                     data-remark='@request.Remark'
                                     data-currentStatus="@request.CurrentStatus">
                                    @request.RequestType.Name
                                </div>
                            }
                        }
                    </td>
                    <td>
                        @if (item.IsOvertime)
                        {
                            <span data-tippy-content="@item.FormattedOvertimeStatus" class="req mytimesheet-@item.FormattedOvertimeStatus.Replace(" ", "") tooltip-tippy">
                                @item.OvertimeHours
                            </span>
                        }
                    </td>
                    <td class="align-left">@item.Notes</td>
                    <td class="td-warning">
                        @if (item.IsWarning)
                        {
                            <span class="icon-warning"></span>
                        }
                    </td>
                </tr>
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 16))
        }
    </tbody>
</table>