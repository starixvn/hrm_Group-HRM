@using HRM.Core
@using HRM.Core.Constants
@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.Report.WorkingCalendarSummaryViewModel
@{
    ViewBag.Title = Labels.WorkingCalendarSummary;
}
@section css{
    <link href="~/dist/styles/report.weeklyworkinghours.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/report.workingcalendar.summary.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a>
    <a class="step" href="@Url.Action("index", "report")">@Labels.Reports</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<form class="filter">
    @Html.HiddenFor(model => model.TeamIds)
    @Html.HiddenFor(model => model.EmployeeStatusIds)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.FromDate, Labels.FromDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("FromDate", Model.FromDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = Constants.MinDate.ToString("yyyy/MM/dd"),
                        maxdate = string.Empty,
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.ToDate, Labels.ToDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox("ToDate", Model.ToDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = Constants.MinDate.ToString("yyyy/MM/dd"),
                        maxdate = string.Empty,
                        disabledDate = string.Empty
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Category, Labels.Category, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @Html.Raw(RazorHelpers.CategoryDropDownList("IsLocal", classHTML: "form-control",
                    selectedId: Model.IsLocal.HasValue ? Model.IsLocal.Value.ToString(): string.Empty))
            </div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Team</label>
            </div>
            <div class="select-form" id="Team"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Keyword, Labels.Keyword, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Employee,
                    new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control", maxlength = 200, autocomplete = "off" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.UserStatus, Labels.UserStatus, new { @class = "control-label" })
            </div>
            <div class="select-form" id="EmployeeStatus"></div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<div id="WorkingCalendarDetails"></div>