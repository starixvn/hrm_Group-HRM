@using HRM.Core
@using HRM.Resources
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.Report.WeekendLeaveViewModel

@{
    ViewBag.Title = Labels.WeekendLeave;
}
@section css{
    <link href="~/dist/styles/report.weekendleave.detail.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/report.weekendleave.detail.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step" href="@Url.Action("weekendleavesummary", "report")">@Labels.WeekendLeaveSummary</a>
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@Labels.WeekendLeaveDetail</h2>
<form class="filter">
    <div class="form-horizontal clearfix">
        @Html.HiddenFor(model => model.TeamId)
        @Html.HiddenFor(model => model.TeamName)
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.DateRange</label>
            </div>
            <div class="select-form">
                @Html.DropDownListFor(model => model.DateRange, Model.DateRange, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.FromDate</label>
            </div>
            <div class="calendar-form">
                @Html.TextBox(Html.NameFor(model => model.FromDate).ToString(),
                    Model.FromDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = new DateTime(2010, 1, 1).ToString("yyyy/MM/dd")
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.ToDate</label>
            </div>
            <div class="calendar-form">
                @Html.TextBox(Html.NameFor(model => model.ToDate).ToString(),
                    Model.ToDate.ToDateMonthYearFormatedDate(),
                    new {
                        @class = "datepicker form-control",
                        mindate = new DateTime(2010, 1, 1).ToString("yyyy/MM/dd")
                    })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Category</label>
            </div>
            <div class="input-form">
                @{
                    var category = new List<SelectListItem>
                    {
                        new() {Text = Labels.All, Value = string.Empty},
                        new() {Text = Labels.Expat, Value = "false"},
                        new() {Text = Labels.Local, Value = "true"}
                    };
                }
                @Html.DropDownListFor(model => model.IsLocal, category, new { @class = "category form-control" })
            </div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Team</label>
            </div>
            <div class="input-form" id="Team"></div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", Model.Employee,
                    new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control" })
                @Html.HiddenFor(model => model.EmployeeId)
            </div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.LeaveTypeId, new { @class = "control-label" })
            </div>
            <div class="select-form">
                @{
                    var leaveType = new List<SelectListItem>
                    {
                        new() {Text = Labels.All, Value = "-1"},
                        new() {Text = Labels.AnnualLeave, Value = "2"},
                        new() {Text = Labels.UnpaidLeave, Value = "25"}
                    };
                }
                @Html.DropDownListFor(model => model.LeaveTypeId, leaveType, new { @class = "form-control" })
            </div>
        </div>

        <div class="form-group form-group--m">
            <button type="button" id="btnSubmit" class="btn btn-primary">@Labels.Submit</button>
            <button type="button" id="btnExcel" class="btn btn-excel">Excel</button>
        </div>
    </div>
</form>
<div id="weekend-leave-detail"></div>