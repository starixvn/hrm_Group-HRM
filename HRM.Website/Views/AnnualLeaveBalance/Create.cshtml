@using HRM.Core
@using HRM.Resources
@model HRM.ViewModels.AnnualLeave.AnnualLeaveTransactionViewModel
@{
    ViewBag.Title = Labels.AdjustAnnualLeaveBalance;
}
@section css{
    <link href="~/dist/styles/annual.leavebalance.employee.create.edit.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/annual.leavebalance.employee.create.edit.js" asp-append-version="true"></script>
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "annualleavebalance")">@Labels.AnualLeaveBalance</a>
    <a class="step" href="~/annualleavebalance/employee/@ViewBag.Employee.Id">
        @ViewBag.Employee.NickName's annual leave balance
    </a>
    <span class="step">@Labels.Adjust</span>
}
@using (Html.BeginForm())
{
    <div class="card form-horizontal">
        @Html.ValidationSummary(true)
        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.TotalDays, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.TotalDays, new { @class = "form-control" })
            </div>
            @Html.ValidationMessageFor(model => model.TotalDays)
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.Description, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextAreaFor(model => model.Description, new { @class = "form-control" })
            </div>
            @Html.ValidationMessageFor(model => model.Description)
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.LabelFor(model => model.AffectedFrom, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @{
                    var minDate = new DateTimeOffset(2010, 1, 1, 0, 0, 0, TimeSpan.Zero).DateTime;
                }
                @Html.TextBox(Html.NameFor(model => model.AffectedFrom), Model.AffectedFrom.ToDateMonthYearFormatedDate(),
                    new { @class = "datepicker form-control", mindate = minDate.ToString("yyyy/MM/dd") })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
            @Html.ValidationMessageFor(model => model.AffectedFrom)
        </div>

        <div class="form-group">
            <div class="label-form">
                @Html.HiddenFor(model => model.EmpId)
            </div>
            <div class="input-form">
                <button type="submit" class="btn btn-primary">@Labels.Adjust</button>
                <a class="btn btn-default" href="~/annualleavebalance/employee/@ViewBag.Employee.Id">@Labels.Cancel</a>
            </div>
        </div>
    </div>
}