@using HRM.Resources
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model bool
@{
    ViewBag.Title = Labels.ExtensionNumber;
}
@section css{
    <link href="~/dist/styles/extensionno.index.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script type="text/javascript">
        window.hasPermission = "@Model";
    </script>
    <script src="~/dist/js/extensionno.home.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a> <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div id="index-extension-no"></div>