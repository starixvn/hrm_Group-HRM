@using HRM.Resources
@model HRM.Models.ExtensionNoModel
@{
    ViewBag.Title = Labels.Create;
}
@section css{
    <link href="~/dist/styles/extensionno.create.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/extensionno.create.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <a class="step" href="@Url.Action("index", "ExtensionNo")">@Labels.ExtensionNumber</a>
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>

<div id="create-extension-no"></div>