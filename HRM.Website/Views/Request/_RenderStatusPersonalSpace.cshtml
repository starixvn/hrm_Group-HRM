@using HRM.Core
@using HRM.Core.Constants
@using HRM.Core.Enums
@using HRM.Models.Request
@using HRM.ViewModels.Request
@model (RequestViewModel RequestViewModel, RequestEntity Request)
@{
    var annualBalance = string.Empty;
    var request = Model.Request;
    if (request.Id == (byte)RequestType.Leave)
    {
        annualBalance = "AL Balance " + request.FromDate.Year + ": " + request.Requester.AnnualLeaveBalance + " && ";
    }
    var requestViewModel = Model.RequestViewModel;
}

@switch (request.Status.Id)
{
    case (byte)CurrentRequestStatus.Pending:
        if (request.ApproverId == requestViewModel.CurrentUserId)
        {
            <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id" companyid="@request.CompanyId"
               href="javascript:void(0);" class="approver-actions tooltip-tipsy"
               title="@annualBalance @request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                @request.Status.ToString()
                <span class="caret"></span>
            </a>
        }
        else if (request.VerifierId == requestViewModel.CurrentUserId)
        {
            <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id" companyid="@request.CompanyId"
               href="javascript:void(0);" class="verifier-actions tooltip-tipsy"
               title="@annualBalance @request.Requester.NickName had @request.TotalDaysRequestInMonth.ToString("0.#") approved request(s) in @request.FromDate.ToMonthAndYearFormatedDate()">
                @request.Status.ToString()
                <span class="caret"></span>
            </a>
        }
        else
        {
            <span>@request.Status.ToString()</span>
        }
        break;
    case (byte)CurrentRequestStatus.Verified:
        if (request.ApproverId == requestViewModel.CurrentUserId)
        {
            <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id" companyid="@request.CompanyId"
               href="javascript:void(0);" class="approver-actions tooltip-tipsy"
               title="@annualBalance @request.Status.Name by @request.VerifierNickName (@request.VerifiedDate.ToShortFormatedDate())">
                @request.Status.ToString()
                <span class="caret"></span>
            </a>
        }
        else if (request.VerifierId == requestViewModel.CurrentUserId)
        {
            <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id" companyid="@request.CompanyId"
               href="javascript:void(0);" class="verifier-actions-reset tooltip-tipsy"
               title="@annualBalance @request.Status.Name by @request.VerifierNickName (@request.VerifiedDate.ToShortFormatedDate())">
                @request.Status.ToString()
                <span class="caret"></span>
            </a>
        }
        else
        {
            <span>@request.Status.ToString()</span>
        }
        break;
    case (byte)CurrentRequestStatus.NotVerified:
        if (request.VerifierId == requestViewModel.CurrentUserId)
        {
            <a roleid="@Convert.ToInt32(RoleSystem.Verifier)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id" companyid="@request.CompanyId"
               href="javascript:void(0);" class="verifier-actions-reset tooltip-tipsy"
               title="@request.Status.Name by @request.VerifierNickName (@request.VerifiedDate.ToShortFormatedDate())">
                @request.Status.ToString()
                <span class="caret"></span>
            </a>
        }
        else
        {
            <span>@request.Status.ToString()</span>
        }
        break;
    case (byte)CurrentRequestStatus.Approved:
    case (byte)CurrentRequestStatus.Rejected:
        if (request.ApproverId == requestViewModel.CurrentUserId)
        {
	        var nexCompanyIds = Constants.NexCompanyIds;
	        var requestCompanyId = request.CompanyId;
	        var isInNexCompany = nexCompanyIds != null && nexCompanyIds.Contains(requestCompanyId);
            var approvedDate = request.ApprovedDate?.ToClientTimeZone();
            if (isInNexCompany)
            {
	            approvedDate = @request.ApprovedDate;
            }
            <a roleid="@Convert.ToInt32(RoleSystem.Approver)" requestid="@request.Id" requesttypeid="@request.RequestType.Id" employeeid="@request.Requester.Id" companyid="@request.CompanyId"
               href="javascript:void(0);" class="approver-actions-reset tooltip-tipsy"
               title="@request.Status.Name by @request.ApproverNickName (@approvedDate.ToShortFormatedDate())">
                @request.Status.ToString()
                <span class="caret"></span>
            </a>
        }
        else
        {
            <span>@request.Status.ToString()</span>
        }
        break;
    case (byte)CurrentRequestStatus.Processed:
    case (byte)CurrentRequestStatus.Void:
        <span class="tooltip-tipsy" title="@request.Status.Name by @request.ProcessedByNickName (@request.ProcessedDate.ToShortFormatedDate())">
            @request.Status.ToString()
        </span>
        break;
    default:
        <span>@request.Status.ToString()</span>
        break;
}
