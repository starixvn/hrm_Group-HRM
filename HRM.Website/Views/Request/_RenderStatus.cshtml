@using HRM.Core.Enums
@using HRM.ViewModels.Request
@using HRM.Models.Request
@model (RequestViewModel RequestViewModel, RequestEntity Request)

@{
	var requestViewModel = Model.RequestViewModel;
	var request = Model.Request;
}

@switch (requestViewModel.ViewType)
{
	case RequestViewType.PersonalSpace:
		@await Html.PartialAsync("_RenderStatusPersonalSpace", (requestViewModel, request))
		break;
	case RequestViewType.SASpace:
		@await Html.PartialAsync("_RenderStatusSASpace", request)
		break;
	default:
		@await Html.PartialAsync("_RenderStatusHRSpace", (requestViewModel, request))
		break;
}
