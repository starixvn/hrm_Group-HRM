@using HRM.Core
@using HRM.Core.Enums
@using HRM.Resources
@using HRM.Services.Implement.Request
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@using System.Linq;
@model HRM.ViewModels.Request.RequestViewModel

@{
    ViewBag.Title = Model.PageTitle;
    int[] nexCompanyIds = ViewBag.NexCompanyIds as int[];
    var hasCheckBoxColumn = Model.ViewType is RequestViewType.PersonalSpace or RequestViewType.HRSpace ? "has-check-box-column" : "";
}
@section css {
    <link href="~/dist/styles/employee.request.css" rel="stylesheet" asp-append-version="true" />
}
@section js {
    <script src="~/dist/js/employee.request.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Model.BreadcrumbText</a><span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@ViewBag.Title</h2>
<div class="filter">
    @await Html.PartialAsync("_SearchForm", Model)
</div>

<div class="table-data">
    <table class="table table-custom" id="data">
        <thead>
        @switch (Model.ViewType)
        {
            case RequestViewType.PersonalSpace:
                <tr>
                    <th colspan="17">
                        <div style="float:right; margin-left: 10px">
                            <input type="button" class="btn btn-primary btnApproveMultiple" id="btnApproveMultiple" command-type="@RequestCommand.Approve" value="@Labels.Approve" />
                        </div>

                        <div style="float:right;">
                            <input type="button" class="btn btn-primary btnApproveMultiple" id="btnApproveMultiple" command-type="@RequestCommand.Accept" value="@Labels.Verify" />
                        </div>
                    </th>
                </tr>
                break;
            case RequestViewType.HRSpace:
                <tr>
                    <th colspan="17">
                        <div style="float:right;">
                            <input type="button" class="btn btn-primary btnApproveMultiple" id="btnApproveMultiple" command-type="@RequestCommand.Process" value="@Labels.Process" />
                        </div>
                    </th>
                </tr>
                break;
        }
            <tr>
                @if (Model.ViewType is RequestViewType.PersonalSpace or RequestViewType.HRSpace)
                {
                    <th>
                        <div class="checkbox">
                            <input type="checkbox" class="checkbox-custom" id="ckbAll" />
                            <label for="ckbAll"></label>
                        </div>
                    </th>
                }
                <th>@Labels.SymbolCount</th>
                <th class="col-sorter">
	                <div class="cell-control-wrapper">
		                @Labels.BusinessUnit
		                <div class="fa fa-sort cell-right-div"></div>
	                </div>
                </th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.Department
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.Team
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.Employee
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.Request
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th>@Labels.Details</th>
                <th>@Labels.Reason</th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.Verifier
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.Approver
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th>@Labels.Remark</th>
                @if (Model.ViewType != RequestViewType.CompanySpace)
                {
                    <th>@Labels.FileAttach</th>
                }
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.CreatedDate
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.Status
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
                <th>@Labels.History</th>
                <th></th>
            </tr>
        </thead>
        @if (Model.Requests != null && Model.Requests.Any())
        {
            var index = 1;
            <tbody id="employee-request-body" class="@hasCheckBoxColumn">
                @foreach (var request in Model.Requests)
                {
	                var requestCompanyId = request.CompanyId;
	                var isInNexCompany = nexCompanyIds != null && nexCompanyIds.Contains(requestCompanyId);

                    <tr id="row@(request.Id)">
                        @switch (Model.ViewType)
                        {
                            case RequestViewType.PersonalSpace:
                            {
                                <td>
                                    <div class="checkbox">
                                        @if (request.ApproverId == Model.CurrentUserId
                                             && request.Status.Id is (byte)CurrentRequestStatus.Pending or (byte)CurrentRequestStatus.Verified)
                                        {
                                            <input type="checkbox"
                                                   class="checkbox-custom chk-request"
                                                   roleid="@Convert.ToInt32(RoleSystem.Approver)"
                                                   requesttypeid="@request.RequestType.Id"
                                                   employeeid="@request.Requester.Id"
                                                   companyid="@request.CompanyId"
                                                   id="@request.CustomId"
                                                   viewtype="@Model.ViewType" />
                                            <label for="@request.CustomId"></label>
                                        }
                                        else {if (request.VerifierId == Model.CurrentUserId && request.Status.Id == (byte)CurrentRequestStatus.Pending)
                                            {
                                                <input type="checkbox"
                                                       class="checkbox-custom chk-request"
                                                       roleid="@Convert.ToInt32(RoleSystem.Verifier)"
                                                       requesttypeid="@request.RequestType.Id"
                                                       employeeid="@request.Requester.Id"
                                                       companyid="@request.CompanyId"
                                                        id="@request.CustomId"
                                                       viewtype="@Model.ViewType" />
                                                <label for="@request.CustomId"></label>
                                            }
                                        }
                                    </div>
                                </td>
                                break;
                            }
                            case RequestViewType.HRSpace:
                            {
                                <td>
                                    <div class="checkbox">
                                        @if (Model.IsAllowChangeStatus && request.Status.Id == (byte)CurrentRequestStatus.Approved)
                                        {
                                            <input type="checkbox"
                                                   class="checkbox-custom chk-request"
                                                   roleid="@Convert.ToInt32(RoleSystem.HR)"
                                                   requesttypeid="@request.RequestType.Id"
                                                   employeeid="@request.Requester.Id"
                                                   companyid="@request.CompanyId"
                                                   id="@request.Id"
                                                   viewtype="@Model.ViewType" />
                                            <label for="@request.Id"></label>
                                        }
                                    </div>
                                </td>
                                break;
                            }
                        }
                        <td>@(index++)</td>
                        <td class="align-left">@request.Requester.UnitCode</td>
                        <td class="align-left">@request.Requester.Team.Department.Name</td>
                        <td class="align-left">@request.Requester.Team.Name</td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.Requester.FullName">@request.Requester.NickName</span>
                        </td>
                        <td>
                            @switch (request.RequestType.Id)
                            {
	                            case (byte)RequestType.Leave:
                                    @if (isInNexCompany)
                                    {
                                        @request.LeaveType.Name
                                    }
                                    else
                                    {
                                        <a href="@Url.Action("Detail", "Leave", new { id = request.Id })">@request.LeaveType.Name</a>
                                    }
		                            break;
	                            case (byte)RequestType.ChangeShift:
		                            @if (isInNexCompany)
		                            {
                                        @request.RequestType.Name
		                            }
		                            else
		                            {
                                        <a href="@Url.Action("Details", "ChangeShift", new { id = request.Id })">@request.RequestType.Name</a>
                                    }
		                            break;
	                            default:
		                            @request.RequestType.Name
		                            break;
		                            ;
                            }
                        </td>
                        <td class="align-left">
                            @Html.Raw(RequestService.ToRequestMessage(request))
                        </td>
                        <td class="align-left">
                            @Html.Raw(RequestService.GetReasonRequest(request.RequestType.Id, request.ReasonId))
                        </td>
                        <td>
                            <span class="tooltip-tipsy" title="@request.VerifierFullName">@request.VerifierNickName</span>
                        </td>
                        <td>
	                        @if (isInNexCompany)
	                        {
                                <span class="tooltip-tipsy" title="@request.ProcessedByFullName">@request.ProcessedByNickName</span>
	                        }
	                        else
	                        {
                                <span class="tooltip-tipsy" title="request.ApproverFullName">@request.ApproverNickName</span>
	                        }
                        </td>
                        <td>
                            @if (!string.IsNullOrWhiteSpace(request.Remark))
                            {
                                <span class="fa fa-comment tooltip-tipsy" title="@request.Remark"></span>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        @if (Model.ViewType != RequestViewType.CompanySpace)
                        {
                            <td>
                                @foreach (var file in request.AttachFiles)
                                {
                                    <a href="@file.FilePath" class="attach-file">
                                        <span class="file-name">@file.FileNameWithoutExtension</span><span class="file-extension">@file.Extension</span>
                                    </a>
                                }
                            </td>
                        }
                        @if (isInNexCompany)
                        {
                            <td data-datetime="@request.OriginalCreatedDate">@request.OriginalCreatedDate?.ToDetailFormatedDate()</td>
                        }
                        else
                        {
	                        <td data-datetime="@request.CreatedDate">@request.CreatedDate.ToDetailFormatedDate()</td>
                        }
                        <td class="status">@await Html.PartialAsync("_RenderStatus", (Model, request))</td>
                        <td>
                            @if (isInNexCompany)
                            {
	                            <a class="viewhistory" href="javascript:;" id="/request/viewhistory/@request.CustomId">@Labels.View</a>
                            }
                            else
                            {
	                            @await Html.PartialAsync("_RenderHistoryLink", request)
                            }
                        </td>
                        <td class="td-warning">
                            @if (request.IsWarning)
                            {
                                <span class="fa fa-exclamation-triangle tooltip-tipsy" title="@Labels.RequestWarning"></span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 17))
        }
    </table>
</div>
<div id="dialoghistorycontent"></div>
<div id="dialogProcessRequest"></div>
<div id="dialogApproveMultipleRequest" role="dialog" class="modal dialogApproveMultipleRequest">
    <form>
        <div class="formrow">
            <div class="validation-summary-valid validation-summary-errors" style="display: none;"></div>
        </div>

        <div class="formrow">
            <div class="label approver-selection">
                <label>@Labels.Violation : </label>
            </div>
            <div class="input radio-btn">
                <input type="radio" id="chk-ignore-all" name="btn-violation" />
                <label for="chk-ignore-all">@Labels.Waive</label>
            </div>
        </div>

        <div class="formrow">
            <div class="label approver-comment">
                <label for="Comment">@Labels.Comment : </label>
            </div>
            <div class="input">
                <textarea class="form-control" cols="20" id="Comment" viewtype="@Model.ViewType" maxlength="500" name="Comment" rows="2"></textarea>
            </div>
        </div>
    </form>
</div>
<div id="dialogProcessMultipleRequest" role="dialog" class="modal dialogProcessRequest">
    <form>
        <div class="formrow">
            <div class="validation-summary-valid validation-summary-errors" style="display: none;"></div>
        </div>
        <div class="formrow">
            <div class="label approver-comment">
                <label for="Comment">@Labels.Comment : </label>
            </div>
            <div class="input">
                <textarea class="form-control" cols="20" id="Comment" viewtype="@Model.ViewType" maxlength="500" name="Comment" rows="2"></textarea>
            </div>
        </div>
    </form>
</div>