@using HRM.Resources
@model int

@{
    ViewBag.Title = Labels.UpdateSecondmentCompany;
}
@section css{
    <link href="~/dist/styles/secondment-company.create.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script>window.empId = '@Model';</script>
    <script src="~/dist/js/secondment-company.edit.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.GroupSpace</a>
    <a class="step" href="@Url.Action("index", "secondmentcompany")">@Labels.SecondmentCompanyManagement</a>
    <span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@Labels.Edit</h2>
<div id="secondment-company-edit"></div>