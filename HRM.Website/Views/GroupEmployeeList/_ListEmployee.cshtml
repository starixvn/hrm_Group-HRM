@using HRM.Core
@using HRM.Resources
@using HRM.ViewModels
@using HRM.Website.Helper
@model IList<HRM.Models.Group.GroupEmployeeModel>
@{
    var pagerOption = (PagerOptionModel)ViewBag.PagerOption;
    const int totalColumn = 24;
}
@section css {
	<link href="~/dist/styles/group.employee.list.index.css" rel="stylesheet" />
}

<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter col-120">
                <div class="cell-control-wrapper">
                    @Labels.CtrID
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-180">
                <div class="cell-control-wrapper">
                    @Labels.EmployeeID
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.NickName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-150">
                <div class="cell-control-wrapper">
                    @Labels.BUIdShort
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-150">
                <div class="cell-control-wrapper">
                    @Labels.UnitCode
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.BUPIC
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.DepartmentNameShort
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.DepartmentPICShort
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
	            <div class="cell-control-wrapper">
		            @Labels.TeamName
		            <div class="fa fa-sort cell-right-div"></div>
	            </div>
            </th>
            <th class="col-sorter col-250">
	            <div class="cell-control-wrapper">
		            @Labels.TeamPIC
		            <div class="fa fa-sort cell-right-div"></div>
	            </div>
            </th>
            <th class="col-sorter col-150">
	            <div class="cell-control-wrapper">
		            @Labels.ERole
		            <div class="fa fa-sort cell-right-div"></div>
	            </div>
            </th>
            <th class="col-sorter col-150">
	            <div class="cell-control-wrapper">
		            @Labels.MRole
		            <div class="fa fa-sort cell-right-div"></div>
	            </div>
            </th>
            <th class="col-sorter col-500">
	            <div class="cell-control-wrapper">
		            @Labels.JobTitle
		            <div class="fa fa-sort cell-right-div"></div>
	            </div>
            </th>
            <th class="col-sorter col-250">
	            <div class="cell-control-wrapper">
		            @Labels.GroupDate
		            <div class="fa fa-sort cell-right-div"></div>
	            </div>
            </th>
            <th class="col-sorter col-150">
                <div class="cell-control-wrapper">
                    @Labels.Company
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var index = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage;
            foreach (var employee in Model)
            {
                index++;
                var cssClass = employee.Enabled ? "" : "disabled";
                <tr class="@cssClass">
                    <td>@index</td>
                    <td>@employee.CtrId</td>
                    <td class="align-left">@employee.EmployeeCode</td>
                    <td class="align-left">@employee.NickName</td>
                    <td class="align-left bu-highlight">@employee.UnitId</td>
                    <td class="align-left bu-highlight">@employee.UnitCode</td>
                    <td class="align-left bu-highlight">@employee.UnitPIC</td>
                    <td class="align-left dept-highlight">@employee.DepartmentName</td>
                    <td class="align-left dept-highlight">@employee.DepartmentPIC</td>
                    <td class="align-left team-highlight">@employee.TeamName</td>
                    <td class="align-left team-highlight">@employee.TeamPIC</td>
                    <td class="align-left">@employee.JobLevel</td>
                    <td class="align-left">@employee.ManagementLevel</td>
                    <td class="align-left">@employee.JobTitle</td>
                    <td class="align-left">
	                    @if (employee.JoinedDate.HasValue)
	                    {
		                    @employee.JoinedDate.Value.ToDateMonthYearFormatedDate()
	                    }
	                </td>
                    <td class="align-left">@employee.Company</td>
                </tr>
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(totalColumn))
        }
    </tbody>
    @if (Model.Any())
    {
        <tfoot>
            <tr>
                <td colspan="@totalColumn" id="pagination">
                    @{
                        var from = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage + 1;
                        var to = from + (Model.Count - 1);
                        IList<SelectListItem> itemsPerPageArray = pagerOption.ItemsPerPageArray.Select(x => new SelectListItem
                        {
                            Text = x.Text,
                            Value = x.Value,
                            Selected = x.Value == pagerOption.ItemsPerPage.ToString()
                        }).ToList();
                    }

                    @Html.Hidden("CurrentPage", pagerOption.CurrentPage)
                    @Html.Hidden("ItemsPerPage", pagerOption.ItemsPerPage)
                    @Html.Hidden("TotalItem", pagerOption.TotalItem)
                    @Html.DropDownList("ItemsPerPageOption", itemsPerPageArray, new { @class = "itemsPerPageOption form-control" })
                    <div class="detailtext">
                        Showing <strong>@from</strong> to <strong>@to</strong> of <strong>@pagerOption.TotalItem</strong> entries
                    </div>
                    <ul id="numberlist" class="pagination"></ul>
                </td>
            </tr>
        </tfoot>
    }
</table>
