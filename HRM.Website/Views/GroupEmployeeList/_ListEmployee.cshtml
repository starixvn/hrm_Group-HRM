@using HRM.Core
@using HRM.Resources
@using HRM.ViewModels
@using HRM.Website.Helper
@model IEnumerable<HRM.Models.Group.GroupEmployeeModel>
@{
    var pagerOption = (PagerOptionModel)ViewBag.PagerOption;
    const byte totalColumn = 24;
    var hasPermissionToEdit = (bool)ViewBag.HasPermissionToEdit;
    var showSalaryCurrency = (bool)ViewBag.ShowSalaryCurrency;
    var showResignedDate = (bool)ViewBag.ShowResignedDate;
}
@section js {
    <script src="~/dist/js/group.employee.list.index.js" asp-append-version="true"></script>
}
@section css {
    <link href="~/dist/styles/group.employee.list.index.css" rel="stylesheet" asp-append-version="true" />
}

<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter col-120">
                <div class="cell-control-wrapper">
                    @Labels.CtrID
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-180">
                <div class="cell-control-wrapper">
                    @Labels.Code
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.NickName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-150">
                <div class="cell-control-wrapper">
                    @Labels.BUIdShort
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.BUPIC
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.DepartmentNameShort
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.DepartmentPICShort
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.TeamName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.TeamPIC
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-150">
                <div class="cell-control-wrapper">
                    @Labels.JobLevel
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-150">
                <div class="cell-control-wrapper">
                    @Labels.ManagementAllowance
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter col-250">
                <div class="cell-control-wrapper">
                    @Labels.GroupDate
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            @if (showResignedDate)
            {
                <th class="col-sorter col-150">
                    <div class="cell-control-wrapper">
                        @Labels.ResignedDate
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
            }
            @if (showSalaryCurrency)
            {
                <th class="col-sorter col-150">
                    <div class="cell-control-wrapper">
                        @Labels.TotalCostUSD
                        <div class="fa fa-sort cell-right-div"></div>
                        <i id="unlockCostIcon" class="fa fa-lock cell-right-div cost-lock-icon"
                           title="Unlock Total Cost"></i>
                    </div>
                </th>
            }
            <th class="col-sorter col-150">
                <div class="cell-control-wrapper">
                    @Labels.Company
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            @if (hasPermissionToEdit)
            {
                <th>@Labels.Role</th>
                <th>@Labels.Edit</th>
            }
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var index = 0;
            foreach (var employee in Model)
            {
                index++;
                var cssClass = employee.Enabled ? "" : "disabled";
                <tr class="@cssClass">
                    <td>@index</td>
                    <td>@employee.CtrIdFormatted</td>
                    <td class="align-left">@employee.EmployeeCode</td>
                    <td class="align-left">@employee.NickName</td>
                    <td class="align-left bu-highlight">@employee.GroupUnitId - @employee.UnitCode</td>
                    <td class="align-left bu-highlight">@employee.UnitPIC</td>
                    <td class="align-left dept-highlight">@employee.DepartmentName</td>
                    <td class="align-left dept-highlight">@employee.DepartmentPIC</td>
                    <td class="align-left team-highlight">@employee.TeamName</td>
                    <td class="align-left team-highlight">@employee.TeamPIC</td>
                    <td class="align-left">@employee.JobLevel</td>
                    <td class="align-left">@employee.ManagementLevel</td>
                    <td class="align-left">
                        @if (employee.JoinedDate.HasValue)
                        {
                            @employee.JoinedDate.Value.ToDateMonthYearFormatedDate()
                        }
                    </td>
                    @if (showResignedDate)
                    {
                        <td class="align-left">@(employee.ResignedDate.HasValue ? employee.ResignedDate.Value.ToDateMonthYearFormatedDate() : "")</td>
                    }
                    @if (showSalaryCurrency)
                    {
                        @* <td class="align-right">@(employee.Salary > 0 ? $"{employee.Salary:N0}" : "-")</td> *@
                        <td class="align-right total-cost-cell" data-amount="@(employee.Salary > 0 ? $"{employee.Salary:N0}" : "-")">
                            *****
                        </td>
                    }
                    <td class="align-left">@employee.Company</td>
                    @if (hasPermissionToEdit)
                    {
                        <td>
                            @Html.ActionLink("Manage", "Edit", "GroupEmployeeList", new { id = employee.EmpId }, null)
                        </td>
                        <td>
                            <a href="@Url.Action("EditInfo", "GroupEmployeeList", new { id = employee.EmpId })" title="Edit">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(totalColumn))
        }
    </tbody>
</table>
<div id="costUnlockDialog" title="Enter Password" style="display:none;">
    <input id="costPassword" type="password" class="form-control" placeholder="Enter password..." autocomplete="new-password" />
    <div id="costError" class="text-danger mt-2" style="display:none;">Wrong password.</div>
</div>