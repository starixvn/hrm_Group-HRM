@using HRM.Resources
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.EmployeeGroup.GroupEmployeeViewModel
@{
    ViewBag.Title = Labels.GroupEmployee;
}
@section css {
    <link href="~/dist/styles/group.employee.list.index.css" rel="stylesheet" asp-append-version="true" />
}
@section js {
    <script src="~/dist/js/group.employee.list.index.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.GroupSpace</a><span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@ViewBag.Title</h2>
<form class="filter">
    <div class="form-horizontal clearfix">
        @Html.HiddenFor(model => model.JobTitleId)
        @Html.HiddenFor(model => model.TeamIds)
        @Html.HiddenFor(model => model.CompanyIds)
        @Html.HiddenFor(model => model.CurrentPage)
        @Html.HiddenFor(model => model.ItemsPerPage)
        @Html.HiddenFor(model => model.CtrIDs)
        @Html.HiddenFor(model => model.Outsources)

        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.Keyword, Labels.NickName, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBoxFor(model => model.Keyword,
                         new { placeholder = Messages.SearchNickName, @class = "form-control", autocomplete = "off" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Team</label>
            </div>
            <div class="input-form" id="GroupTeam"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Company</label>
            </div>
            <div class="input-form" id="Company"></div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
        <div class="label-form">
                <label class="control-label">@Labels.EmployeeStatus</label>
            </div>
            <div class="select-form input-form">
                <select class="form-control" id="EmployeeStatus" name="EmployeeStatus">
                    <option value="">@Labels.All</option>
                    <option value="1" selected>Active</option>
                    <option value="2">Disabled</option>
                    <option value="3">Deleted</option>
                </select>
            </div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.AccountType</label>
            </div>
            <div class="input-form" id="IsCtrID"></div>
        </div>

        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.OutsourcedEmployee</label>
            </div>
            <div class="input-form" id="IsOutsource"></div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group">
            <button id="query" type="button" class="btn btn-primary">@Labels.Submit</button>
            <button type="button" id="exportExcel" class="btn btn-excel">Excel - Employee List</button>
            <button type="button" id="exportExcelProfitCenter" class="btn btn-excel">Excel - Profit Center Report</button>
            <a class="btn btn-request" href="@Url.Action("transfer", "groupemployeelist")">
                <span class="fa fa-plus"></span> @Labels.EmployeeTransfer
            </a>
        </div>
    </div>
</form>
<div id="group-employee-list"></div>
<div id="tippy-avatar" class="tippy-avatar"></div>