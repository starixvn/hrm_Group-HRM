@using HRM.Core
@using HRM.Models.Log
@using HRM.Resources
@using HRM.Website.Helper
@model IEnumerable<LogObjectDetail>
@{
    ViewBag.Title = Labels.ActivityLog;
}
@section css{
    <link href="~/dist/styles/employee.log.details.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
}
@section Breadcrumb
{
    <a class="step" href="javascript:;">@Labels.GroupSpace</a>
    <a class="step" href="@Url.Action("index", "GroupEmployeeList")">@Labels.GroupEmployee</a>
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@Labels.Employee: @ViewBag.Employee</h2>
<table class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.LogDate</th>
            <th>@Labels.Action</th>
            <th>@Labels.Actor</th>
            <th>@Labels.Field</th>
            <th>@Labels.OldValue</th>
            <th>@Labels.NewValue</th>
        </tr>
    </thead>
    <tbody>
        @if (Model.Any())
        {
            var rowIndex = 1;
            foreach (var item in Model)
            {
                RenderRows(rowIndex, item);
                rowIndex++;
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(5))
        }
    </tbody>
</table>

@{
    void RenderRows(int rowIndex, LogObjectDetail item)
    {
        var rowClass = rowIndex % 2 == 0 ? "odd" : "even";
        var childRowIndex = 1;
        foreach (var field in item.Fields)
        {
            <tr class="@rowClass">
                @if (childRowIndex == 1)
                {
                    var mergeRow = item.Fields.Count;
                    <td class="align-left" rowspan="@mergeRow">@item.LogDate.ToDetailFormatedDate()</td>
                    <td rowspan="@mergeRow">@item.Action</td>
                    <td rowspan="@mergeRow">@item.Nickname</td>
                }
                <td class="align-left">@field.DisplayName</td>
                <td class="align-left">@field.OldValue</td>
                <td class="align-left">@field.Value</td>
            </tr>
            childRowIndex++;
        }
    }
}
