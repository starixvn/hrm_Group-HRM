@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.UI.HeaderViewModel

<div class="header_wrap">
    <div>
        <div class="logo">
            <img src="~/dist/styles/images/hrm_logo.png" alt="HRM" width="120" height="30" />
        </div>
        @if (Model.IsShowSearchBox)
        {
            <div class="search_bar">
                <form class="search" method="get" asp-controller="employee" asp-action="index" accept-charset="UTF-8" id="search">
                    <input type="text" autocomplete="off" placeholder="Nickname or full name" name="query" id="searchbox" class="text-field" />
                    <a id="searchIcon" class="search_btn"><span class="icon magnifier"></span></a>
                </form>
            </div>
        }
    </div>

    <div>
        <div class="quick-access dropdown-container">
            <button class="dropdown-toggle">Quick Access</button>
            <ul class="dropdown-list">
                <li><a asp-controller="dashboard" asp-action="index">EPA</a></li>
                <li><a asp-controller="employee" asp-action="index">EPA</a></li>
                <li><a asp-controller="attendance" asp-action="index">EPA</a></li>
                <li><a asp-controller="leave" asp-action="index">EPA</a></li>
                <li><a asp-controller="payroll" asp-action="index">EPA</a></li>
                <li><a asp-controller="report" asp-action="index">EPA Test 12345</a></li>
            </ul>
        </div>

        <div id="user_utilities" class="dropdown_navigation" style="z-index: 1000;">
            <h2>
                @Model.Employee.FullName - <i>@Model.Employee.Nickname</i>
            </h2>
            <a href="javascript:;" class="dropdown_arrow"></a>
            <ol class="global_navigation">
                <li><a asp-controller="leave" asp-action="create">Request leave</a></li>
                <li><a asp-controller="changeshift" asp-action="create">Request change shift</a></li>
                <li><a asp-controller="lateinearlyout" asp-action="create">Request late in - early out</a></li>
                <li><a asp-controller="checkinout" asp-action="create">Request check in/out</a></li>
                <li><a asp-controller="account" asp-action="index">My profile</a></li>
                <li><a asp-controller="account" asp-action="changepwd">Change Password</a></li>
                <li><a asp-controller="auth" asp-action="logout">Logout</a></li>
            </ol>
        </div>
    </div>
</div>
<script>
    var _global = {
        isShowLeftNavigation: '@ViewBag.IsShowLeftNavigation'
    };
</script>