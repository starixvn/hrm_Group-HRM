@using HRM.Core.Enums
@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.Overtime.EditMonthlyRequestViewModel
@{
    ViewBag.Title = Model.MonthlyRequest.Requester.Nickname + "'s Overtime Request in " + Model.MonthlyRequest.Month.ToString("MMM-yyyy");
}
@section css{
    <link href="~/dist/styles/overtime.edit.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/overtime.edit.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <a class="step" href="@Url.Action("employeeview", "overtime")">@Labels.MyOvertimeRequest</a>
    <a class="step">@Labels.Edit</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<form>
    @Html.Hidden("WorkingHours", Model.MonthlyRequest.Requester.WorkingHours)
    @Html.Hidden("EmployeeId", Model.MonthlyRequest.Requester.EmpId)
    @Html.Hidden("Month", Model.MonthlyRequest.Month)
    @Html.Hidden("AutoApproveRequest", Model.AutoApproveRequest)
    <div class="header-control">
        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(Labels.Verifier, Labels.Verifier, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @if (Model.Verifiers.Count() > 1 || Model.AutoApproveRequest)
                    {
                        @Html.DropDownListFor(model => model.VerifierId, new SelectList(Model.Verifiers, "OwnerId", "NickName"), Labels.SelectVerifier, new { @class = "form-control" })
                    }
                    else
                    {
                        @Html.DropDownListFor(model => model.VerifierId, new SelectList(Model.Verifiers, "OwnerId", "NickName"), new { @class = "form-control" })
                    }
                </div>
            </div>
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(Labels.Approver, Labels.Approver, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @if (Model.Approvers.Count() > 1 || Model.AutoApproveRequest)
                    {
                        @Html.DropDownListFor(model => model.ApproverId, new SelectList(Model.Approvers, "OwnerId", "NickName"), Labels.SelectApprover, new { @class = "form-control" })
                    }
                    else
                    {
                        @Html.DropDownListFor(model => model.ApproverId, new SelectList(Model.Approvers, "OwnerId", "NickName"), new { @class = "form-control" })
                    }
                </div>
            </div>
            <div class="form-group form-group--m">
                <div class="label-form status">
                    @Html.Label(Labels.Status + ":", Labels.Status + ":", new { @class = "control-label" })
                    @(Model.MonthlyRequest.Status != null && !string.IsNullOrWhiteSpace(Model.MonthlyRequest.Status.ToString()) ? Model.MonthlyRequest.Status.ToString() : "N/A")
                </div>
            </div>
        </div>
        <div>
            <button type="button" id="btnSave" class="btn btn-primary">@Labels.Save</button>
            <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>
        </div>
    </div>
    <table class="table table-custom" id="data">
        <thead>
            <tr>
                <th>@Labels.Date</th>
                <th>@Labels.Schedule</th>
                <th>@Labels.TimeIn</th>
                <th>@Labels.TimeOut</th>
                <th>@Labels.TotalHours</th>
                <th>@Labels.NormalDay</th>
                <th>@Labels.OffDay</th>
                <th>@Labels.PublicHoliday</th>
                <th>@Labels.SpecialOT</th>
                <th>@Labels.Remark</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                foreach (var request in Model.MonthlyRequest.DailyOvertimes)
                {
                    <tr>
                        @{
                            var className = string.Empty;
                            if (request.IsHoliday)
                            {
                                className = "holiday";
                            }
                            else if (request.WorkDate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
                            {
                                className = "weekend";
                            }
                        }
                        <td class="@className workdate" data-workdate="@request.WorkDate.ToString("dd-MMM-yyyy")">
                            @request.WorkDate.ToString("dd-MMM-yyyy (ddd)")
                        </td>
                        <td class="shift" data-shiftid="@request.ShiftId">
                            @if (!string.IsNullOrWhiteSpace(request.ShiftCode))
                            {
                                @request.ShiftCode
                            }
                            else if (request.IsHoliday)
                            {
                                @Labels.Holiday
                            }
                            else if (request.IsOffDay)
                            {
                                @Labels.Off
                            }
                        </td>
                        <td class="timeIn">@request.TimeIn</td>
                        <td class="timeOut">@request.TimeOut</td>
                        <td class="totalHours">
                            @if (request.ActualWorkingHours > 0)
                            {
                                @request.ActualWorkingHours
                            }
                        </td>
                        <td class="cell-overtime">
                            @if (request.ActualWorkingHours > 0
                                && !request.IsKeepInView
                                && !request.IsOffDay && !request.IsHoliday
                                && request.ActualWorkingHours > Model.MonthlyRequest.Requester.WorkingHours)
                            {
                                @Html.TextBoxFor(model => request.NormalHours, new { @class = "normalHours form-control", maxlength = 5, autocomplete = "off" })
                            }
                        </td>
                        <td class="cell-overtime">
                            @if (request.ActualWorkingHours > 0 && !request.IsKeepInView && request.IsOffDay && !request.IsHoliday)
                            {
                                @Html.TextBoxFor(model => request.OffHours, new { @class = "offHours form-control", maxlength = 5, autocomplete = "off" })
                            }
                        </td>
                        <td class="cell-overtime">
                            @if (request.ActualWorkingHours > 0 && !request.IsKeepInView
                                && request.IsHoliday && request.HolidayTypeId == (byte)HolidayType.Regular)
                            {
                                @Html.TextBoxFor(model => request.PublicHours, new { @class = "publicHours form-control", maxlength = 5, autocomplete = "off" })
                            }
                        </td>
                        <td class="cell-overtime">
                            @{ 
                                className = $"specialHours form-control {(request.IsHoliday && request.HolidayTypeId == (byte)HolidayType.Special ? "specialPH" : string.Empty)}";
                            }
                            @if ((Model.MonthlyRequest.Requester.SpecialOT > 0
                                && request.ActualWorkingHours > 0
                                && !request.IsKeepInView
                                && !request.IsOffDay && !request.IsHoliday
                                && request.ActualWorkingHours >= Model.MonthlyRequest.Requester.WorkingHours + Model.MonthlyRequest.Requester.SpecialOT)
                                || request.IsHoliday && request.HolidayTypeId == (byte)HolidayType.Special)
                            {
                                @Html.TextBoxFor(model => request.SpecialHours, new { @class = className, maxlength = 5, autocomplete = "off" })
                            }
                            else
                            {
                                if (request.SpecialHours > 0)
                                {
                                    @Html.TextBoxFor(model => request.SpecialHours, new { @class = className, maxlength = 5, autocomplete = "off", @readonly = "readonly" })
                                }
                            }
                        </td>
                        <td>
                            @if (request.ActualWorkingHours > 0 && !request.IsKeepInView)
                            {
                                if (request.IsOffDay || request.IsHoliday || request.ActualWorkingHours > Model.MonthlyRequest.Requester.WorkingHours)
                                {
                                    @Html.TextBoxFor(model => request.Remark, new { @class = "remark form-control", maxlength = 2000, autocomplete = "off" })
                                }
                            }
                        </td>
                    </tr>
                }
            }
            else
            {
                @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 13))
            }
        </tbody>
        <tfoot>
            <tr class="summary">
                <td class="sumhours align-right">
                    @Labels.TotalOvertimeHours:
                </td>
                <td></td>
                <td></td>
                <td></td>
                <td></td>
                <td id="sumnormal">
                    @Model.MonthlyRequest.DailyOvertimes.Sum(t => t.NormalHours).ToString("0.00")
                </td>
                <td id="sumoff">
                    @Model.MonthlyRequest.DailyOvertimes.Sum(t => t.OffHours).ToString("0.00")
                </td>
                <td id="sumpublic">
                    @Model.MonthlyRequest.DailyOvertimes.Sum(t => t.PublicHours).ToString("0.00")
                </td>
                <td id="sumspecial">
                    @Model.MonthlyRequest.DailyOvertimes.Sum(t => t.SpecialHours).ToString("0.00")
                </td>
                <td></td>
            </tr>
        </tfoot>
    </table>
</form>