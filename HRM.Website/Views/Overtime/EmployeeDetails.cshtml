@using HRM.Core.Enums
@using HRM.Resources
@using HRM.Website.Helper
@model HRM.Models.Overtime.MonthlyOvertimeRequest
@{
    ViewBag.Title = Labels.MemberOvertime + " of " + Model.Requester.Nickname + " (" + Model.Month.ToString("MMM-yyyy") + ")";
    var verifier = $"{Model.Verifier.Nickname} ({Model.Verifier.FullName})";
    var approver = $"{Model.Approver.Nickname} ({Model.Approver.FullName})";
}

@section css{
    <link href="~/dist/styles/overtime.member.details.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/overtime.hr.details.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.Personal</a> <a class="step">@ViewBag.Title</a>
}

<h2 class="page-title">@ViewBag.Title</h2>

<div class="header-control">
    @Html.Hidden("RequestId", Model.RequestId)
    @Html.Hidden("StatusId", Model.Status.Id)
    <div class="form-horizontal clearfix">
        <span>
            ※ @Html.Label(null,Labels.VerifiedBy + ": ", new { @class = "control-label" })
            @verifier
        </span>
        <span>
            ※ @Html.Label(null, Labels.ApprovedBy + ": ", new { @class = "control-label" })
            @approver
        </span>
        <span>
            ※ @Html.Label(null,Labels.Status + ": ", new { @class = "control-label" })
            @Model.Status.ToString()
        </span>
    </div>

    <div>
        @switch (Model.Status.Id)
        {
            case (byte)CurrentRequestStatus.Approved:
                RenderApprovedButtons();
                break;
            case (byte)CurrentRequestStatus.Processed:
            case (byte)CurrentRequestStatus.Void:
                RenderResetButton();
                break;
            default:
                // do nothing
                break;
        }

        <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>
    </div>
</div>
<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.Date</th>
            <th>@Labels.Shift</th>
            <th>@Labels.TimeIn</th>
            <th>@Labels.TimeOut</th>
            <th>@Labels.TotalHours</th>
            <th>@Labels.NormalDay</th>
            <th>@Labels.OffDay</th>
            <th>@Labels.PublicHoliday</th>
            <th>@Labels.SpecialOT</th>
            <th>@Labels.Remark</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model.DailyOvertimes.Any())
        {
            foreach (var request in Model.DailyOvertimes)
            {
                <tr>
                    @{
                        var className = string.Empty;
                        if (request.IsHoliday)
                        {
                            className = "holiday";
                        }
                        else if (request.WorkDate.DayOfWeek is DayOfWeek.Saturday or DayOfWeek.Sunday)
                        {
                            className = "weekend";
                        }
                    }
                    <td class="@className">
                        @request.WorkDate.ToString("dd-MMM-yyyy (ddd)")
                    </td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(request.ShiftCode))
                        {
                            @request.ShiftCode
                        }
                        else if (request.IsHoliday)
                        {
                            @Labels.Holiday
                        }
                        else if (request.IsOffDay)
                        {
                            @Labels.Off
                        }
                    </td>
                    <td>@request.TimeIn</td>
                    <td>@request.TimeOut</td>
                    <td>
                        @{RenderHours(request.ActualWorkingHours);}
                    </td>
                    <td>
                        @{RenderHours(request.NormalHours);}
                    </td>
                    <td>
                        @{RenderHours(request.OffHours);}
                    </td>
                    <td>
                        @{RenderHours(request.PublicHours);}
                    </td>
                    <td>
                        @{RenderHours(request.SpecialHours);}
                    </td>
                    <td class="align-left">@request.Remark</td>
                    @if (request.TotalShiftHours != 0 && (request.ActualWorkingHours >= request.TotalShiftHours + 1
                        || (request.NormalHours > request.ActualWorkingHours - Model.Requester.WorkingHours
                            && request.ActualWorkingHours >= Model.Requester.WorkingHours)))
                    {
                        var tooltip = "[Total Working Hours]/[Shift Hours]: " + request.ActualWorkingHours + " / " + request.TotalShiftHours;
                        <td class="tooltip-tipsy" title="@tooltip">
                            <i class="fa fa-exclamation-triangle"></i>
                        </td>
                    }
                    else
                    {
                        <td></td>
                    }
                </tr>
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 11))
        }
    </tbody>
    <tfoot>
        <tr class="summary">
            <td class="align-right" colspan="5">@Labels.TotalOvertimeHours:</td>
            <td>@Model.DailyOvertimes.Sum(t => t.NormalHours).ToString("0.00")</td>
            <td>@Model.DailyOvertimes.Sum(t => t.OffHours).ToString("0.00")</td>
            <td>@Model.DailyOvertimes.Sum(t => t.PublicHours).ToString("0.00")</td>
            <td>@Model.DailyOvertimes.Sum(t => t.SpecialHours).ToString("0.00")</td>
            <td></td>
            <td></td>
        </tr>
    </tfoot>
</table>
@await Html.PartialAsync("_ConfirmModal")

@{
    void RenderHours(decimal hours)
    {
        if (hours > 0)
        {
            @hours
        }
    }

    void RenderApprovedButtons()
    {
        <input type="button" class="btn btn-primary" id="btnProcess" value="@Labels.Process" />
        <input type="button" class="btn btn-primary" id="btnVoid" value="@Labels.Void" />
    }

    void RenderResetButton()
    {
        <input type="button" class="btn btn-primary" id="btnReset" value="@Labels.Reset" />
    }
}