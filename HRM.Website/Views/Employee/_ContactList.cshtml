@using HRM.Core
@using HRM.Models
@using HRM.Resources
@using HRM.ViewModels
@using HRM.Website.Helper
@model IEnumerable<Employee>
@{
    var pagerOption = (PagerOptionModel)ViewBag.PagerOption;
    var isShowJobTitle = (bool)ViewBag.IsShowJobtitle;
    var enableGroupDate = ViewBag.EnableGroupDate;
}

<table id="data" class="table table-custom">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Department
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Team
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Code
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.FullName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.NickName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            @if (isShowJobTitle)
            {
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.JobTitle
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
            }
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Email
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Phone
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.ExtNo
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            @if (enableGroupDate)
            {
                <th class="col-sorter">
                    <div class="cell-control-wrapper">
                        @Labels.GroupDate
                        <div class="fa fa-sort cell-right-div"></div>
                    </div>
                </th>
            }
            <th></th>
        </tr>
    </thead>
    <tbody>
        @if (Model != null && Model.Any())
        {
            var index = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage;
            foreach (var employee in Model)
            {
                index++;
                var cssClass = employee.Enabled ? string.Empty : "disabled";
                <tr class="@cssClass">
                    <td>@index</td>
                    <td class="align-left">@employee.Team.Department.Name</td>
                    <td class="align-left">@employee.Team.Name</td>
                    <td>@employee.Code</td>
                    <td class="align-left">@employee.FullName</td>
                    <td>
                        <a class="avatar-tooltip" data-code="@employee.Code">@employee.NickName</a>
                    </td>
                    @if (isShowJobTitle)
                    {
                        <td class="align-left">@employee.JobTitle</td>
                    }
                    <td class="align-left">
                        <a href="mailto:@employee.Email">@employee.Email</a>
                    </td>
                    <td>
                        @employee.Phone
                    </td>
                    <td>
                        @employee.ExtensionNo
                    </td>
                    @if (enableGroupDate)
                    {
                        <td>
                            @if (employee.JoinedDate.HasValue)
                            {
                                @employee.JoinedDate.Value.ToDateMonthYearFormatedDate()
                            }
                        </td>
                    }
                    <td>
                        <a href="javascript:;" class="xicon avatar fullSizeAvatar" data-code="@employee.Code" data-nickName="@employee.NickName"></a>
                    </td>
                </tr>
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 14))
        }
    </tbody>
    <tfoot>
        <tr>
            <td colspan="14" id="pagination">
                @{
                    var from = (pagerOption.CurrentPage - 1) * pagerOption.ItemsPerPage + 1;
                    var to = from + (Model.Count() - 1);
                    var itemsPerPageArray = pagerOption.ItemsPerPageArray.Select(x => new SelectListItem
                    {
                        Text = x.Text,
                        Value = x.Value,
                        Selected = x.Value == pagerOption.ItemsPerPage.ToString()
                    }).ToList();
                }

                @Html.Hidden("CurrentPage", pagerOption.CurrentPage)
                @Html.Hidden("ItemsPerPage", pagerOption.ItemsPerPage)
                @Html.Hidden("TotalItem", pagerOption.TotalItem)
                @Html.DropDownList("ItemsPerPageOption", itemsPerPageArray, new { @class = "itemsPerPageOption form-control" })
                <div class="detailtext">
                    Showing <strong>@from</strong> to <strong>@to</strong> of <strong>@pagerOption.TotalItem</strong> entries
                </div>
                <ul id="numberlist" class="pagination"></ul>
            </td>
        </tr>
    </tfoot>
</table>