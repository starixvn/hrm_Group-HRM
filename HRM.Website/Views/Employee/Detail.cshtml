@using HRM.Core
@using HRM.Core.Enums
@using HRM.Resources
@model HRM.Models.Employee
@{
    ViewBag.Title = Model.NickName + " (" + Model.FullName + ") 's Personal Information";
    var hasPermission = (bool)ViewBag.HasPermission;
    bool enableGroupDate = ViewBag.EnableGroupDate;
}
@section css{
    <link href="~/dist/styles/employee.details.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/dist/styles/account.index.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
}
@section Breadcrumb {
    <a class="step">Personal</a>
    @if (hasPermission)
    {
        <a class="step" href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
    }
    else
    {
        <a class="step" href="@Url.Action("index", "employee")">Contact list</a>
    }
    <span class="step">@ViewBag.Title</span>
}
<script>
    fetch('@Url.Action("Avatar", "Employee", new { id = Model.Code })')
        .then(response => response.text())
        .then(avatarUrl => {
            document.getElementById('avatar-img').src = avatarUrl;
        });
</script>
<div class="leftpersonal">
    <div class="panel panel-default">
        <div class="panel-heading avatarbox">
            <div class="avatar">
                <img id="avatar-img" src="" alt="@Model.NickName" />
            </div>
            <div class="pinfo">
                <span class="name">@Model.FullName</span>
                <p class="accinfo">
                    @Model.DomainUsername
                    <br />
                    Staff ID: @Model.Code
                </p>
            </div>
        </div>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">PERSONAL INFORMATION</div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.FullName:</div>
                <div class="pcontent bold">@Model.FullName</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Nick:</div>
                <div class="pcontent bold">@Model.NickName</div>
            </li>
            @if (hasPermission)
            {
                <li class="list-group-item">
                    <div class="plabel">D.O.B:</div>
                    <div class="pcontent bold">
                        @Model.DateOfBirth.ToDateMonthYearFormatedDate()
                    </div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.Gender:</div>
                <div class="pcontent bold">
                    @(Model.Gender == 1 ? Labels.Male : Labels.Female)
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Nationality:</div>
                <div class="pcontent bold">@Model.CountryName</div>
            </li>
            @if (hasPermission)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.Marriage:</div>
                    <div class="pcontent bold">
                        @{
                            var status = (MarriageStatus)Model.Marriage;
                        }
                        @status.ToString()
                    </div>
                </li>
                <li class="list-group-item">
                    <div class="plabel">@Labels.CardNo:</div>
                    <div class="pcontent bold">@Model.CardNo</div>
                </li>
                if (!string.IsNullOrEmpty(Model.PassportNo))
                {
                    <li class="list-group-item">
                        <div class="plabel">@Labels.PassportNo:</div>
                        <div class="pcontent bold">@Model.PassportNo</div>
                    </li>
                }
                if (Model.PassportExp.HasValue)
                {
                    <li class="list-group-item">
                        <div class="plabel">@Labels.PassportExp:</div>
                        <div class="pcontent bold">
                            @Model.PassportExp.Value.ToDateMonthYearFormatedDate()
                        </div>
                    </li>
                }
                if (Model.MilitaryFromDate.HasValue && Model.MilitaryToDate.HasValue)
                {
                    <li class="list-group-item">
                        <div class="plabel">@Labels.MilitaryFromDate:</div>
                        <div class="pcontent bold">
                            @Model.MilitaryFromDate.Value.ToDateMonthYearFormatedDate()
                        </div>
                    </li>
                    <li class="list-group-item">
                        <div class="plabel">@Labels.MilitaryToDate:</div>
                        <div class="pcontent bold">
                            @Model.MilitaryToDate.Value.ToDateMonthYearFormatedDate()
                        </div>
                    </li>
                }
                if (Model.WorkingDays > 0)
                {
                    <li class="list-group-item">
                        <div class="plabel">@Labels.WorkingDays:</div>
                        <div class="pcontent bold">@Model.WorkingDays</div>
                    </li>
                }
                if (Model.WorkingHours > 0)
                {
                    <li class="list-group-item">
                        <div class="plabel">@Labels.WorkingHours:</div>
                        <div class="pcontent bold">@Model.WorkingHours</div>
                    </li>
                }
            }
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">JOB INFORMATION</div>
        <ul class="list-group">
            @if (hasPermission)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.JobTitle:</div>
                    <div class="pcontent bold">@Model.JobTitle</div>
                </li>
            }
            @if (Model.PromotionDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.PromotionDate:</div>
                    <div class="pcontent bold">@Model.PromotionDate.Value.ToDateMonthYearFormatedDate()</div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.Team:</div>
                <div class="pcontent bold">@Model.Team.Name</div>
            </li>
            @if (Model.TeamDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.TeamDate:</div>
                    <div class="pcontent bold">@Model.TeamDate.Value.ToDateMonthYearFormatedDate()</div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.Roles:</div>
                <div class="pcontent bold">@Model.Roles2String</div>
            </li>
            @if (enableGroupDate)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.GroupDate:</div>
                    <div class="pcontent bold">
                        @if (Model.JoinedDate.HasValue)
                        {
                            @Model.JoinedDate.Value.ToDateMonthYearFormatedDate()
                        }
                    </div>
                </li>
            }
            <li class="list-group-item">
                <div class="plabel">@Labels.CompanyDate:</div>
                <div class="pcontent bold">
                    @if (Model.CompanyDate.HasValue)
                    {
                        @Model.CompanyDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.ConfirmedDate:</div>
                <div class="pcontent bold">
                    @if (Model.ConfirmedDate.HasValue)
                    {
                        @Model.ConfirmedDate.Value.ToDateMonthYearFormatedDate()
                    }
                </div>
            </li>
            @if (Model.ResignedDate.HasValue)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.ResignedDate:</div>
                    <div class="pcontent bold">
                        @Model.ResignedDate.Value.ToDateMonthYearFormatedDate()
                    </div>
                </li>
            }
            </ul>
    </div>
</div>
<div class="rightjob">
    <div class="panel panel-default">
        <div class="panel-heading">CONTACT DETAILS</div>
        <ul class="list-group">
            <li class="list-group-item">
                <div class="plabel">@Labels.Email:</div>
                <div class="pcontent bold">
                    <a href="mailto:@Model.Email">@Model.Email</a>
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.Phone:</div>
                <div class="pcontent bold">@Model.Phone</div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.LetsTalk:</div>
                <div class="pcontent bold">@Model.LetsTalk</div>
            </li>
            @if (hasPermission)
            {
                <li class="list-group-item">
                    <div class="plabel">@Labels.Address:</div>
                    <div class="pcontent bold">@Model.Address</div>
                </li>
                <li class="list-group-item">
                    <div class="plabel">@Labels.CurrentAddress:</div>
                    <div class="pcontent bold">@Model.CurrentAddress</div>
                </li>
            }
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">ATTENDANCE REPORT</div>
        <ul class="list-group attendance">
            <li class="list-group-item">
                <div class="plabel">@Labels.AnualLeaveBalance:</div>
                <div class="pcontent bold">
                    @Model.AnnualLeaveBalance day(s)
                </div>
            </li>
            <li class="list-group-item">
                <div class="plabel">@Labels.CompensationLeaveBalance:</div>
                <div class="pcontent bold">
                    @Model.KeepInViewBalance day(s)
                </div>
            </li>
            @if (Model.IsDefaultSchedule)
            {
                <li class="list-group-item">
                    <div class="plabel">
                        Default Working Calendar:
                    </div>
                    <div class="pcontent">
                        <div class="schedule">
                            <div class="day">@Labels.Mon:</div>
                            <div class="shift">@ViewBag.Mon</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Tue</div>
                            <div class="shift">@ViewBag.Tue</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Wed:</div>
                            <div class="shift">@ViewBag.Wed</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Thu</div>
                            <div class="shift">@ViewBag.Thu</div>
                        </div>
                        <div class="schedule">
                            <div class="day">@Labels.Fri</div>
                            <div class="shift">@ViewBag.Fri</div>
                        </div>
                        <div class="schedule off">
                            <div class="day">@Labels.Sat</div>
                            <div class="shift">@ViewBag.Sat</div>
                        </div>
                        <div class="schedule off">
                            <div class="day">@Labels.Sun</div>
                            <div class="shift">@ViewBag.Sun</div>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>
    <div class="panel panel-default">
        <div class="panel-heading">HISTORY WORK</div>
        <table class="table table-custom" id="data" style="margin: 0">
            <thead>
                <tr>
                    <th>@Labels.Date</th>
                    <th>@Labels.Actor</th>
                    <th>@Labels.Field</th>
                    <th>@Labels.OldValue</th>
                    <th>@Labels.NewValue</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.HistoryWork)
                {
                    <tr>
                        <td>@item.LogDate.ToDateMonthYearFormatedDate()</td>
                        <td>@item.Nickname</td>
                        <td>@item.Field</td>
                        <td class="align-left">@item.OldData</td>
                        <td class="align-left">@item.Data</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>