@using HRM.Resources
@{
    ViewBag.Title = "Edit Employee Supervisor";
    var employeeId = (int)ViewBag.EmployeeId;
    var roleId = (short)ViewBag.RoleId;
    var companyId = (int)ViewBag.CompanyId;
}
@section css{
    <link href="~/dist/styles/team.edit.discipline.manager.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/employee.edit.discipline.manager.js" asp-append-version="true"></script>
}
@section Breadcrumb
{
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("usermanagement", "employee")" class="step">@Labels.EmployeeManagement</a>
    <a href="@Url.Action("edit", "employee", new { id = employeeId })" class="step">@Labels.EmployeePersonalInformation</a>
    <a class="step">@Labels.DisciplineManager</a>
}

@Html.Hidden("EmployeeId", employeeId)
@Html.Hidden("CompanyId", companyId)
@Html.Hidden("RoleId", roleId)
<div id="discipline-wrapper"></div>