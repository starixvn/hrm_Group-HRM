@using HRM.Core
@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.EmployeeWorkFromHome.EmployeeWorkFromHomeFilterViewModel
@{
    ViewBag.Title = Labels.EmployeeWorkFromHome;
    var today = DateTimeOffset.Now.DateTime.ToClientTimeZone().Date;
    var maxDate = new DateTimeOffset(today.Year + 2, 1, 1, 0, 0, 0, TimeSpan.Zero).AddDays(-1);
    var aa = Model.IsPermanent;
}
@section css{
    <link href="~/dist/styles/employee.workfromhome.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/employee.workfromhome.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("usermanagement", "employee")">@Labels.EmployeeManagement</a>
    <a class="step">@ViewBag.Title</a>
}
<form class="filter">
    @using (Html.BeginForm())
    {
        @Html.HiddenFor(model => model.TeamIds)
        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.FromDateFilter, Labels.FromDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @Html.TextBox(Html.NameFor(model => model.FromDateFilter),
                        Model.FromDateFilter.ToDateMonthYearFormatedDate(),
                        new
                             {
                            @class = "datepicker form-control",
                            @readonly = "readonly",
                            maxdate = maxDate.ToString("yyyy/MM/dd")
                        })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </div>
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.LabelFor(model => model.ToDateFilter, Labels.ToDate, new { @class = "control-label" })
                </div>
                <div class="calendar-form">
                    @Html.TextBox(Html.NameFor(model => model.ToDateFilter),
                        Model.ToDateFilter.ToDateMonthYearFormatedDate(),
                        new
                             {
                            @class = "datepicker form-control",
                            @readonly = "readonly",
                            maxdate = maxDate.ToString("yyyy/MM/dd")
                        })
                    <i class="icon-calendar fa fa-calendar"></i>
                </div>
            </div>
        </div>
        <div class="form-horizontal clearfix">
            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(null, Labels.Category, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.Raw(RazorHelpers.CategoryDropDownList("IsLocal",
                        classHTML: "form-control",
                        selectedId: Model.IsLocal.HasValue ? Model.IsLocal.Value.ToString() : string.Empty))
                </div>
            </div>
            <div class="form-group form-group--m">
                <div class="label-form">
                    <label class="control-label">@Labels.Team</label>
                </div>
                <div class="select-form" id="Team"></div>
            </div>

            <div class="form-group form-group--m">
                <div class="label-form">
                    @Html.Label(null, Labels.Type, new { @class = "control-label" })
                </div>
                <div class="select-form">
                    @Html.Raw(RazorHelpers.WorkFromHomeTypeDropDownList("IsPermanent",
                        classHTML: "form-control",
                        selectedId: Model.IsPermanent.HasValue ? Model.IsPermanent.Value.ToString() : string.Empty))
                </div>
            </div>

            <div class="form-group form-group--m">
                <input class="btn btn-primary" type="submit" id="submit" value="@Labels.Submit" />
                <button class="btn btn-request" id="add-workfromhome" type="button">
                    <span class="fa fa-plus"></span>
                    @Labels.AddEmployeeWorkFromHome
                </button>
                <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
            </div>
        </div>
    }
</form>
<div id="list-workfromhome"></div>
<div id="dialog"></div>