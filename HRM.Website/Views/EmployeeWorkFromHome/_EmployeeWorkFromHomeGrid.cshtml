@using HRM.Core
@using HRM.Resources
@using HRM.Website.Helper
@model IEnumerable<HRM.Models.EmployeeWorkFromHome>

<table class="table table-custom" id="data">
    <thead>
        <tr>
            <th>@Labels.SymbolCount</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.BusinessUnit
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Department
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Team
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.Code
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.FullName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.NickName
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.From
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.To
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th>@Labels.Remark</th>
            <th>@Labels.FileAttach</th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.CreatedBy
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            <th class="col-sorter">
                <div class="cell-control-wrapper">
                    @Labels.CreatedDate
                    <div class="fa fa-sort cell-right-div"></div>
                </div>
            </th>
            @if (ViewBag.IsHost)
            {
                <th>@Labels.Action</th>
            }
        </tr>
    </thead>
    <tbody>
        @{var index = 1;}
        @if (Model.Any())
        {

            foreach (var item in Model)
            {
                <tr>
                    <td>@(index++)</td>
                    <td class="align-left">@item.UnitCode</td>
                    <td class="align-left">@item.DepartmentName</td>
                    <td class="align-left">@item.TeamName</td>
                    <td>@item.Code</td>
                    <td class="align-left">@item.FullName</td>
                    <td>@item.Nickname</td>
                    <td>@item.FromDate.ToDateMonthYearFormatedDate()</td>
                    <td>@item.ToDate.ToDateMonthYearFormatedDate()</td>
                    <td>
                        @if (!string.IsNullOrWhiteSpace(item.Remark))
                        {
                            <span class="fa fa-comment tooltip-tipsy" original-title="@item.Remark"></span>
                        }
                    </td>
                    <td>
                        @foreach (var file in item.AttachFiles)
                        {
                            <a href="@file.FilePath" class="attach-file" download>
                                <span class="file-name">@file.FileNameWithoutExtension</span><span class="file-extension">@file.Extension</span>
                            </a>
                        }
                    </td>
                    <td>@item.Modifier</td>
                    <td>@item.ModifiedDate.ToFormatedDate()</td>
                    @if (ViewBag.IsHost)
                    {
                        <td class="action-column">
                            <a data-id="@item.EmployeeWorkFromHomeId" class="edit-employeeworkfromhome" title="@Labels.Edit">
                                <i class="fa fa-pencil fa-lg icon-edit"></i>
                            </a>
                            <a data-id="@item.EmployeeWorkFromHomeId" class="delete-employeeworkfromhome" title="@Labels.Delete">
                                <i class="fa fa-times fa-lg icon-delete"></i>
                            </a>
                        </td>
                    }
                </tr>
            }
        }
        else
        {
            @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 15))
        }
    </tbody>
</table>