@using HRM.Resources
@model HRM.ViewModels.Team.DisciplineRuleViewModel
@{
    ViewBag.Title = Labels.DisciplineRule;
    var disabled = Model.IsHost ? string.Empty : "disabled";
}
@section css{
    <link href="~/dist/styles/team.discipline.rule.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/team.discipline.rule.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a class="step" href="@Url.Action("index", "team")">@Labels.TeamManagement</a>
    <span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@Labels.DisciplineRule for @Model.Team</h2>
@Html.HiddenFor(model => model.TeamId)
<table id="tabledata" class="table table-custom" style="width: auto; min-width: 500px;">
    <thead>
        <tr>
            <th>@Labels.DisciplineType</th>
            <th>
                @Labels.Local
                <div class="checkbox">
                    <input type="checkbox" class="checkbox-custom" id="ckbAllLocal">
                    <label for="ckbAllLocal"></label>
                </div>
            </th>
            <th>
                @Labels.Expat
                <div class="checkbox">
                    <input type="checkbox" class="checkbox-custom" id="ckbAllExpat">
                    <label for="ckbAllExpat"></label>
                </div>
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var discipline in Model.DisciplineRules)
        {
            <tr data-disciplinetypeid="@discipline.DisciplineTypeId">
                <td class="align-left">@discipline.Name</td>
                <td>
                    <div class="checkbox">
                        <input type="checkbox" class="checkbox-custom ckb-local" name="local" id="local@(discipline.DisciplineTypeId)"
                               @(discipline.IsApplyForLocal ? "checked" : string.Empty) @disabled />
                        <label for="local@(discipline.DisciplineTypeId)"></label>
                    </div>
                </td>
                <td>
                    <div class="checkbox">
                        <input type="checkbox" class="checkbox-custom ckb-expat" name="expat" id="expat@(discipline.DisciplineTypeId)"
                               @(discipline.IsApplyForExpat ? "checked" : string.Empty) @disabled />
                        <label for="expat@(discipline.DisciplineTypeId)"></label>
                    </div>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.IsHost)
{
    <button type="button" id="btnSubmit" class="btn btn-primary">@Labels.Save</button>
}
    <button type="button" class="btn btn-default" onclick="window.history.back()">@Labels.Back</button>