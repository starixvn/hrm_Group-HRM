@using HRM.Resources
@{
    ViewBag.Title = "Edit Team Supervisor";
    var teamId = (int)ViewBag.TeamId;
    var roleId = (short)ViewBag.RoleId;
    var companyId = (int)ViewBag.CompanyId;
}
@section css{
    <link href="~/dist/styles/team.edit.discipline.manager.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/team.edit.discipline.manager.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a>
    <a href="@Url.Action("index", "team")" class="step">@Labels.TeamManagement</a>
    <a href="@Url.Action("TeamSupervisor", "team", new { id = teamId })" class="step">@Labels.TeamSupervisor</a>
    <a class="step">@Labels.DisciplineManager</a>
}

@Html.Hidden("TeamId", teamId)
@Html.Hidden("CompanyId", companyId)
@Html.Hidden("RoleId", roleId)
<div id="discipline-wrapper"></div>