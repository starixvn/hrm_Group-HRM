@using HRM.Core.Enums
@using HRM.Resources
@using HRM.Website.Helper
@model IEnumerable<HRM.Models.Team>
@{
    ViewBag.Title = Labels.TeamManagement;
    var hasPermission = (bool)ViewBag.HasPermission;
    var hasPermissionToViewEmployee = (bool)ViewBag.HasPermissionToViewEmployee;
    int companyId = ViewBag.CompanyId;
}
@section css{
    <link href="~/dist/styles/team.index.css" rel="stylesheet" />
}
@section js{
    <script src="~/dist/js/team.index.js"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.HRSpace</a><span class="step">@ViewBag.Title</span>
}
<h2 class="page-title">@ViewBag.Title</h2>
@using (Html.BeginForm("index", "team", FormMethod.Get, new { @class = "filter" }))
{
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(null, Labels.Keyword, new { @class = "control-label" })
            </div>
            <div class="input-form">
                <input id="nameSearch" type="text" name="keyWord" placeholder="@Messages.SearchTeamOrCode" class="form-control" autocomplete="off" />
            </div>
        </div>
        <button class="btn btn-primary" type="submit" id="btnSearchTeam">@Labels.Submit</button>

        @Html.ActionLink("Employee Permission Summary", "EmployeeSupervisor", "report", null, new { @class = "btn btn-primary" })
        @Html.ActionLink("Team Permission Summary", "TeamSupervisor", "report", null, new { @class = "btn btn-primary" })
    </div>
}
<table id="data" class="table table-custom" style="width: auto; min-width: 600px;">
    <thead>
        <tr>
            <th rowspan="2">@Labels.SymbolCount</th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Department</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Team</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Code</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.PIC</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Email</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th colspan="2">@Labels.BasicAnnualLeaveBalance</th>
            <th colspan="2">@Labels.WorkingDaysPerMonth</th>
            <th colspan="2">@Labels.WorkingHoursPerWeek</th>
            <th colspan="2">@Labels.WorkingHoursPerDay</th>
            <th colspan="2">@Labels.NumberOfOffday</th>
            <th colspan="2">@Labels.YearsOfServiceForExtraLeave</th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.TotalExpat</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.TotalLocal</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th rowspan="2" class="col-sorter">
                <div class="cell-control-wrapper">
                    <div>@Labels.Total</div>
                    <div class="fa fa-sort"></div>
                </div>
            </th>
            <th rowspan="2">@Labels.DisciplineRule</th>
            @if (hasPermission)
            {
	            <th rowspan="2">@Labels.Edit</th>
                <th rowspan="2">@Labels.Roles</th>
            }
        </tr>
        <tr>
            <th>@Labels.Local</th>
            <th>@Labels.Expat</th>
            <th>@Labels.Local</th>
            <th>@Labels.Expat</th>
            <th>@Labels.Local</th>
            <th>@Labels.Expat</th>
            <th>@Labels.Local</th>
            <th>@Labels.Expat</th>
            <th>@Labels.Local</th>
            <th>@Labels.Expat</th>
            <th>@Labels.Local</th>
            <th>@Labels.Expat</th>
        </tr>
    </thead>
    @if (Model != null && Model.Any())
    {
        <tbody>
            @{var index = 1;}
            @foreach (var team in Model)
            {
                <tr id="row@(team.Id)">
                    <td>@(index++)</td>
                    <td class="align-left">@team.Department.Name</td>
                    <td class="align-left">@team.Name</td>
                    <td>@team.Code</td>
                    <td>@team.PICNickName
                        @(companyId != team.PICCompanyId && !string.IsNullOrEmpty(@team.PICNickName) ? $" ({team.PICCompanyName})" : "")
                    </td>
                    <td class="align-left">@team.MailGroup</td>
                    <td>@team.LocalBasicAnnualLeaveBalance</td>
                    <td>@team.ExpatBasicAnnualLeaveBalance</td>
                    <td>@team.LocalWorkingDays</td>
                    <td>@team.ExpatWorkingDays</td>
                    <td>@team.LocalWorkingHoursbyWeek</td>
                    <td>@team.ExpatWorkingHoursbyWeek</td>
                    <td>@team.LocalWorkingHours</td>
                    <td>@team.ExpatWorkingHours</td>
                    <td>@team.LocalOffDaysbyWeek</td>
                    <td>@team.ExpatOffDaysbyWeek</td>
                    <td>@team.LocalYearsOfServiceForExtraLeave</td>
                    <td>@team.ExpatYearsOfServiceForExtraLeave</td>
                    <td>@team.TotalExpat</td>
                    <td>@team.TotalLocal</td>
                    <td>
                        @if (team.NoOfMembers > 0 && hasPermissionToViewEmployee)
                        {
                            <a href="@Url.Action("UserManagement", "Employee", new { teamIds = team.Id })">@team.NoOfMembers</a>
                        }
                        else
                        {
                            <span>@team.NoOfMembers</span>
                        }
                    </td>
                    <td>
                        <a href="@Url.Action("disciplinerule", "team", new { team.Id })">Manage</a>
                    </td>
                    @if (hasPermission)
                    {
                        <td>
                            <a href="@Url.Action("Edit", "team", new { team.Id })"><i class="fa fa-pencil fa-lg icon-edit"></i></a>
                        </td>
                        <td>
                            <a href="@Url.Action("TeamSupervisor", "Team", new { team.Id })">Manage</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    }
    else
    {
        @Html.Raw(RazorHelpers.DisplayNoInformation(colspan: 25))
    }
</table>
