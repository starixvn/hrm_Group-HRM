@using HRM.Core
@model HRM.ViewModels.Information.EmployeeRelationshipViewModel

@using (Html.BeginForm("EditRelationship", "Information", FormMethod.Post, new { @class = "dialog-form form-horizontal" }))
{
    @Html.AntiForgeryToken();
    @Html.ValidationSummary();

    <div class="form-group">
        <div class="label-form">
            @Html.LabelFor(model => model.FullName, new { @class = "control-label" })
        </div>
        <div class="input-form">
            @Html.TextBox("FullName", Model.FullName, new { @class = "form-control", autocomplete = "off" })
        </div>
    </div>

    <div class="form-group">
        <div class="label-form">
            @Html.LabelFor(model => model.BirthDay, new { @class = "control-label" })
        </div>
        <div class="calendar-form">
            @Html.TextBox("BirthDay", Model.BirthDay.ToDateMonthYearFormatedDate(),
                     new { @class = "datepicker form-control", maxDate = DateTimeOffset.Now.DateTime.ToClientTimeZone() })
            <i class="icon-calendar fa fa-calendar"></i>
        </div>
    </div>

    <div class="form-group">
        <div class="label-form">
            @Html.LabelFor(model => model.Gender, new { @class = "control-label" })
        </div>
        <div class="input-form">
            @{
                var gender = new List<SelectListItem>
                {
                    new() {Text = "Female", Value = "0"},
                    new() {Text = "Male", Value = "1"},
                };
            }
            @Html.DropDownList("Gender", gender, new { @class = "form-control" })
        </div>
    </div>

    <div class="form-group">
        <div class="label-form">
            @Html.LabelFor(model => model.Phone, new { @class = "control-label" })
        </div>
        <div class="input-form">
            @Html.TextBox("Phone", Model.Phone, new { @class = "form-control", autocomplete = "off" })
        </div>
    </div>

    <div class="form-group">
        <div class="label-form">
            @Html.LabelFor(model => model.Relationship, new { @class = "control-label" })
        </div>
        <div class="input-form">
            @Html.TextBox("Relationship", Model.Relationship, new { @class = "form-control", autocomplete = "off" })
        </div>
    </div>

    <div class="form-group">
        <div class="label-form">
            @Html.LabelFor(model => model.IsEmergency, new { @class = "control-label" })
        </div>
        <div class="input-form">
            <div class="checkbox">
                <input @(Model.IsEmergency ? "checked" : "") class="checkbox-custom" id="IsEmergency" name="IsEmergency" type="checkbox" value="true">
                <label for="IsEmergency"></label>
                <input type="hidden" name="IsEmergency" value="false">
            </div>
        </div>
    </div>
}