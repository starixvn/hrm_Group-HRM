@using HRM.Resources
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model bool
@{
    ViewBag.Title = Labels.JobTitleManagement;
}
@section css{
    <link href="~/dist/styles/jobtitle.css" rel="stylesheet" />
}
@section js{
    <script type="text/javascript">
        window.hasPermission = "@Model";
    </script>
    <script src="~/dist/js/jobtitle.index.js"></script>

}
@section Breadcrumb {
    <a class="step">@ViewBag.Title</a>
}
<h2 class="page-title">@ViewBag.Title</h2>
<div id="job-title"></div>