@using HRM.Core
@using HRM.Resources
@using HRM.Website.Helper
@using Microsoft.AspNetCore.Mvc.TagHelpers
@model HRM.ViewModels.Calendar.WorkingCalendarFilterViewModel
@{
    ViewBag.Title = Labels.WorkingCalendars;
    var minDate = new DateTimeOffset(2010, 1, 1, 0, 0, 0, TimeSpan.Zero).DateTime;
}
@section css{
    <link href="~/dist/styles/workingcalendars.css" rel="stylesheet" asp-append-version="true" />
}
@section js{
    <script src="~/dist/js/workingcalendar.js" asp-append-version="true"></script>
}
@section Breadcrumb {
    <a class="step">@Labels.CompanySpace</a>
    <span class="step">@ViewBag.Title</span>
}

<h2 class="page-title">@ViewBag.Title</h2>

<form class="filter">
    @Html.HiddenFor(model => model.TeamIds)
    @Html.HiddenFor(model => model.JobTitleIds)
    @Html.HiddenFor(model => model.EmployeeId)
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.FromDate, Labels.FromDate, new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox(Html.NameFor(model => model.FromDate), Model.FromDate.ToDateMonthYearFormatedDate(),
                    new { @class = "datepicker form-control", mindate = minDate.ToString("yyyy/MM/dd") })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.LabelFor(model => model.ToDate, Labels.ToDate , new { @class = "control-label" })
            </div>
            <div class="calendar-form">
                @Html.TextBox(Html.NameFor(model => model.ToDate), Model.ToDate.ToDateMonthYearFormatedDate(),
                    new { @class = "datepicker form-control", mindate = minDate.ToString("yyyy/MM/dd") })
                <i class="icon-calendar fa fa-calendar"></i>
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.Team</label>
            </div>
            <div class="select-form" id="Team"></div>
        </div>
    </div>
    <div class="form-horizontal clearfix">
        <div class="form-group form-group--m">
            <div class="label-form">
                <label class="control-label">@Labels.JobTitle</label>
            </div>
            <div class="select-form" id="JobTitle"></div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Employee, Labels.Employee, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.TextBox("Employee", string.Empty,
                    new { placeholder = Messages.SearchEmployeeWatermark, @class = "form-control", maxlength = 200, autocomplete = "off" })
            </div>
        </div>
        <div class="form-group form-group--m">
            <div class="label-form">
                @Html.Label(Labels.Category, Labels.Category, new { @class = "control-label" })
            </div>
            <div class="input-form">
                @Html.Raw(RazorHelpers.CategoryDropDownList("IsLocal", "form-control"))
            </div>
        </div>
        <div class="form-group form-group--m">
            <button type="button" class="btn btn-primary" id="btnSearch">@Labels.Search</button>
            <button type="button" class="btn btn-excel" id="btnExcel">@Labels.Excel</button>
        </div>
    </div>
</form>
<div id="workingCalendarDetails"></div>