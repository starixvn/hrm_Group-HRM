# Ignore version control system files
.git
.gitignore

# Ignore build outputs
bin/
obj/

# Ignore user-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore logs and temp files
*.log
logs/
*.tmp
*.temp

# Ignore IDE and editor folders
.vscode/
.idea/

# Ignore Docker files that shouldn't be in context
Dockerfile*

# Ignore JavaScript source files
HRM.Website/wwwroot/sources/js/
HRM.Website/wwwroot/sources/libs/
HRM.Website/wwwroot/sources/styles/abstracts/
HRM.Website/wwwroot/sources/styles/base/
HRM.Website/wwwroot/sources/styles/components/
HRM.Website/wwwroot/sources/styles/fonts/
HRM.Website/wwwroot/sources/styles/layout/
HRM.Website/wwwroot/sources/styles/pages/
HRM.Website/wwwroot/sources/styles/vendors/

# Ignore other unnecessary files
*.md
*.DS_Store
Thumbs.db