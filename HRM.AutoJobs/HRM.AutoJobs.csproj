<Project Sdk="Microsoft.NET.Sdk.Worker">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="App_Data\SpNames.xml" />
    <None Remove="EmailTemplates\RemindUseAL.txt" />
    <None Remove="EmailTemplates\StatisticALBalance.txt" />
    <None Remove="logs\log.txt" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Data\SpNames.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\RemindUseAL.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="EmailTemplates\StatisticALBalance.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="logs\log.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Cronos" Version="0.9.0" />
    <PackageReference Include="Fanex.Data" Version="4.3.3" />
    <PackageReference Include="Fanex.Data.Repository" Version="4.3.3" />
    <PackageReference Include="Fanex.Data.SqlServer" Version="4.3.3" />
    <PackageReference Include="Fanex.Logging.Extensions.AspNetCore" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Extensions.Database" Version="1.1.0" />
    <PackageReference Include="Fanex.Logging.Sentry" Version="2.0.2" />
    <PackageReference Include="jose-jwt" Version="5.1.1" />
    <PackageReference Include="MailKit" Version="4.11.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="9.0.2" />
    <PackageReference Include="NLog.Web.AspNetCore" Version="5.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HRM.Core\HRM.Core.csproj" />
    <ProjectReference Include="..\HRM.Letstalk.Core\HRM.Letstalk.Core.csproj" />
  </ItemGroup>
</Project>
